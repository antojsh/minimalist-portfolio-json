---
interface Props {
  title?: string
  id?: string
}

const { title, id } = Astro.props
---

<section id={id}>
  {title && <h2>{title}</h2>}
  <slot />
</section>

<script>
  // se ejecuta en el cliente <----
</script>

<style>
  section {
    max-width: 960px;
    margin: 0 auto 64px;
  }

  h2 {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 8px;
    color: var(--text);
    font-size: 1.35rem;
    font-weight: 750;
    letter-spacing: -0.04em;
  }

  h2::after {
    height: 1px;
    flex: 1;
    background: var(--line);
    content: "";
  }
</style>
