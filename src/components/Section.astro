---
interface Props {
  title?: string
  id?: string
  class?: string
}

const { title, id, class: className } = Astro.props
---

<section id={id} class:list={["reveal", className]}>
  {
    title && (
      <header>
        <h2>{title}</h2>
      </header>
    )
  }
  <slot />
</section>

<script>
  // se ejecuta en el cliente <----
</script>

<style>
  section {
    margin-bottom: clamp(5rem, 11vw, 8.5rem);
    scroll-margin-top: 1.5rem;
  }

  header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  header::after {
    flex: 1;
    height: 1px;
    background: var(--line-strong);
    content: "";
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  @media print {
    section {
      margin-bottom: 1.75rem;
    }

    header {
      margin-bottom: 0.9rem;
      break-after: avoid;
    }

    h2 {
      font-size: 1.6rem;
    }
  }
</style>
