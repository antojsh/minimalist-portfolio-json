---
import Section from "../Section.astro"

import { basics, personalProjects } from "@cv"
import { getYearsOfExperience } from "@/lib/cv"

const { summary } = basics
const yearsOfExperience = getYearsOfExperience()
const productNames = new Intl.ListFormat("es", { type: "conjunction" }).format(
  personalProjects.map(({ name }) => name)
)
---

<Section id="sobre-mi" title="Sobre mí">
  <div class="about">
    <div class="summary">
      <p>{summary}</p>
    </div>

    <div class="stat stat-dark">
      <strong>{yearsOfExperience}+</strong>
      <span>años construyendo productos web</span>
    </div>

    <div class="stat stat-soft">
      <strong>{personalProjects.length}</strong>
      <span>productos propios: {productNames}</span>
    </div>
  </div>
</Section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 280px);
    gap: 16px;
  }

  .summary {
    position: relative;
    display: flex;
    grid-row: span 2;
    align-items: center;
    padding: clamp(28px, 4.5vw, 52px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .summary::before {
    position: absolute;
    top: clamp(28px, 4.5vw, 52px);
    bottom: clamp(28px, 4.5vw, 52px);
    left: -1px;
    width: 4px;
    border-radius: 0 4px 4px 0;
    background: var(--accent);
    content: "";
  }

  .summary p {
    max-width: 62ch;
    color: var(--text);
    font-size: clamp(1.1rem, 1.7vw, 1.32rem);
    letter-spacing: -0.01em;
    line-height: 1.6;
  }

  .stat {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    padding: 26px 28px;
    border-radius: var(--radius-lg);
  }

  .stat strong {
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 6vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.85;
  }

  .stat span {
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .stat-dark {
    background:
      radial-gradient(circle at 100% 0%, rgba(226, 88, 58, 0.28), transparent 60%),
      var(--dark);
    color: rgba(255, 255, 255, 0.74);
  }

  .stat-dark strong {
    color: var(--accent);
  }

  .stat-soft {
    background: var(--accent-soft);
    color: var(--text);
  }

  .stat-soft strong {
    color: var(--accent-ink);
  }

  @media (max-width: 760px) {
    .about {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .summary {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }

  @media (max-width: 420px) {
    .stat {
      padding: 22px;
    }
  }

  @media print {
    .summary,
    .stat {
      border: 1px solid var(--line);
      box-shadow: none;
      break-inside: avoid;
    }

    .stat-dark {
      background: #fff;
      color: var(--text-soft);
    }

    .stat-dark strong {
      color: var(--accent-ink);
    }
  }
</style>
