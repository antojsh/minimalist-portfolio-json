---
import Section from "../Section.astro"
import SocialLinks from "@/components/SocialLinks.astro"
import Mail from "@/icons/Mail.astro"

import { basics } from "@cv"
const { email } = basics
---

<Section id="contacto" class="no-print">
  <div class="contact">
    <span class="eyebrow">Contacto</span>
    <h2>¿Construimos algo <em>útil</em> juntos?</h2>
    <p>
      Construyo productos completos, del frontend al backend: interfaces, APIs
      con Node.js y apps móviles. Si tienes una idea o un producto por mejorar,
      escríbeme y lo conversamos.
    </p>
    <div class="actions">
      {
        email && (
          <a class="button" href={`mailto:${email}`}>
            <Mail />
            {email}
          </a>
        )
      }
      <SocialLinks tone="dark" />
    </div>
  </div>
</Section>

<style>
  .contact {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
    padding: clamp(48px, 8vw, 96px) clamp(24px, 6vw, 80px);
    border-radius: 32px;
    background:
      radial-gradient(
        circle at 50% 0%,
        rgba(226, 88, 58, 0.38),
        transparent 55%
      ),
      radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.08) 1px, transparent 0)
        0 0 / 24px 24px,
      var(--dark);
    color: #fff;
    text-align: center;
  }

  .eyebrow {
    padding: 6px 12px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.8);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 16ch;
    margin-top: 22px;
    color: #fff;
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.98;
  }

  h2 em {
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 1.12em;
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  p {
    max-width: 50ch;
    margin-top: 20px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.08rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 50px;
    padding: 0 24px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--ink);
    font-size: 1rem;
    font-weight: 600;
    transition:
      transform 200ms var(--ease-out),
      background 200ms ease;
  }

  .button:hover {
    background: #fff;
    transform: translateY(-2px);
  }

  .button :global(svg) {
    width: 18px;
    height: 18px;
  }
</style>
