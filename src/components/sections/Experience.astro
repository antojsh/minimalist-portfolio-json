---
import Section from "../Section.astro"

import { work } from "@cv"
---

<Section title="Experiencia laboral">
  <ul>
    {
      work.map(
        ({ name, startDate, endDate, position, summary }) => {
          const startYear = new Date(startDate).getFullYear()
          const endYear =
            endDate != null ? new Date(endDate).getFullYear() : "Actual"
          const years = `${startYear} - ${endYear}`

          return (
            <li>
              <article>
                <header>
                  <div>
                    <h3>{name}</h3>
                    <h4>{position}</h4>
                  </div>

                  <time>{years}</time>
                </header>

                <footer>
                  <p>{summary}</p>
                </footer>
              </article>
            </li>
          )
        }
      )
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  li {
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }

  li:last-child {
    border-bottom: 1px solid var(--line);
  }

  article {
    display: grid;
    grid-template-columns: minmax(170px, 0.35fr) minmax(0, 1fr);
    gap: 28px;
  }

  article h3 {
    color: var(--text);
    font-size: 1rem;
    font-weight: 700;
  }

  article h4 {
    margin-top: 5px;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 500;
  }

  time {
    display: block;
    margin-top: 3px;
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 700;
  }

  @media (max-width: 600px) {
    article {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
