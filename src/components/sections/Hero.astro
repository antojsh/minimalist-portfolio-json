---
import { basics } from "@cv"
import Section from "@/components/Section.astro"
import Mail from "@/icons/Mail.astro"
import X from "@/icons/X.astro"
import LinkedIn from "@/icons/LinkedIn.astro"
import GitHub from "@/icons/GitHub.astro"
import WorldMap from "@/icons/WorldMap.astro"

const { name, label, image, location, profiles, email } = basics
const { city, region } = location

const SOCIAL_ICONS: Record<string, any> = {
  GitHub,
  LinkedIn,
  X,
}

const linkedInfo = profiles.find(({ network }) => network === "LinkedIn")
const linkedUrl = linkedInfo?.url
const printInfo = [email, linkedUrl].filter(Boolean).join(" • ")
---

<Section>
  <div class="container">
    <div class="info">
      <h1>{name}</h1>
      <h2>{label}</h2>
      <span class="location"><WorldMap /> {city}, {region}</span>
      <p class="intro">
        Construyo interfaces y productos web que hacen más clara la tecnología
        para las personas que la usan.
      </p>
      <div class="actions no-print">
        <a href="#proyectos-personales">Ver proyectos personales <span aria-hidden="true">↗</span></a>
        {email && <a class="mail-link" href={`mailto:${email}`}><Mail /> Escribirme</a>}
      </div>
      <footer class="print">{printInfo}</footer>
      <footer class="socials no-print">
        {
          profiles.map(({ network, url }) => {
            const Icon = SOCIAL_ICONS[network]

            return (
              <a
                href={url}
                title={`Visitar el perfil de ${name} en ${network}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon />
                <span>{network}</span>
              </a>
            )
          })
        }
      </footer>
    </div>

    <figure>
      <img src={image} alt={name} />
      <figcaption>Disponible para construir cosas útiles.</figcaption>
    </figure>
  </div>
</Section>

<style>
  .container {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    align-items: center;
    gap: clamp(2rem, 7vw, 7rem);
    min-height: 360px;
    padding: 32px 0 56px;
  }

  .info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .location,
  figcaption {
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.01em;
  }

  h1 {
    color: var(--text);
    font-size: clamp(2.7rem, 6vw, 4.7rem);
    font-weight: 780;
    letter-spacing: -0.085em;
    line-height: 0.98;
  }

  h2 {
    max-width: 620px;
    margin-top: 18px;
    color: #4f5b65;
    font-size: clamp(1rem, 2vw, 1.3rem);
    font-weight: 520;
    letter-spacing: -0.04em;
    line-height: 1.3;
  }

  .location {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: 14px;
  }

  .intro {
    max-width: 520px;
    margin-top: 22px;
    font-size: 0.92rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 13px;
    border: 1px solid var(--text);
    border-radius: 6px;
    color: var(--text);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .actions a:first-child {
    color: #fff;
    background: var(--text);
  }

  .actions a:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: #fff;
  }

  .actions .mail-link {
    border-color: var(--line);
    background: var(--surface);
  }

  .actions :global(svg) {
    width: 14px;
    height: 14px;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 28px;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 8px;
    border: 1px solid var(--line);
    border-radius: 5px;
    color: var(--muted);
    font-size: 0.65rem;
  }

  .socials a:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .socials :global(svg) {
    width: 14px;
    height: 14px;
  }

  figure {
    position: relative;
    justify-self: end;
    width: 100%;
  }

  img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 16px;
    object-fit: cover;
  }

  figcaption {
    position: relative;
    z-index: 2;
    display: inline-block;
    margin-top: 22px;
    padding-left: 14px;
  }

  figcaption::before {
    position: absolute;
    top: 0.35em;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    content: "";
  }

  @media (max-width: 700px) {
    .container {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-top: 12px;
    }

    figure {
      justify-self: start;
      width: min(220px, 58vw);
      order: -1;
    }
  }
</style>
