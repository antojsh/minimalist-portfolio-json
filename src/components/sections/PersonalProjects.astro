---
import Section from "../Section.astro"

import { personalProjects } from "@cv"
import { getHostname } from "@/lib/cv"

// Con un número impar de proyectos, el primero ocupa todo el ancho
const hasFeatured = personalProjects.length % 2 === 1
---

<Section id="proyectos-personales" title="Proyectos personales">
  <p class="intro">
    Productos que he construido por iniciativa propia, desde la idea y la
    experiencia hasta la implementación.
  </p>

  <ul class="projects">
    {
      personalProjects.map((project, index) => (
        <li class:list={{ featured: hasFeatured && index === 0 }}>
          <article class={project.accent}>
            <div class="media">
              <img
                src={project.image}
                alt={`Vista de ${project.name}`}
                loading="lazy"
              />
            </div>

            <div class="body">
              <span class="kind">{project.kind}</span>
              <h3>
                <a
                  href={project.url}
                  title={`Visitar ${project.name}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {project.name}
                </a>
              </h3>
              <p>{project.description}</p>
              {project.mission && <p class="mission">{project.mission}</p>}
              <ul class="tags">
                {project.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
              <footer>
                <span>{getHostname(project.url)}</span>
                <span class="arrow no-print" aria-hidden="true">
                  ↗
                </span>
              </footer>
            </div>
          </article>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .intro {
    max-width: 60ch;
    margin: -0.75rem 0 2rem;
    font-size: 1.05rem;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2.4vw, 28px);
  }

  article {
    --project-accent: var(--accent-ink);
    --project-soft: var(--accent-soft);

    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: 28px;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition:
      transform 350ms var(--ease-out),
      box-shadow 350ms var(--ease-out),
      border-color 350ms ease;
  }

  article.violet {
    --project-accent: #5b4fc4;
    --project-soft: #eeecfb;
  }

  article.green {
    --project-accent: #2f7055;
    --project-soft: #e6f0ea;
  }

  article.amber {
    --project-accent: #8a5300;
    --project-soft: #fff0d4;
  }

  article:hover {
    border-color: color-mix(in srgb, var(--project-accent) 35%, var(--line));
    box-shadow: 0 32px 60px -32px
      color-mix(in srgb, var(--project-accent) 60%, transparent);
    transform: translateY(-6px);
  }

  article:has(a:focus-visible) {
    outline: 2px solid var(--project-accent);
    outline-offset: 4px;
  }

  .media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 20px;
    background: #ece8e0;
  }

  /* Borde sutil para que las imágenes claras no se pierdan en la tarjeta */
  .media::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(21, 25, 30, 0.07);
    pointer-events: none;
    content: "";
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }

  article:hover .media img {
    transform: scale(1.045);
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 12px;
    padding: 22px 18px 12px;
  }

  .kind {
    color: var(--project-accent);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h3 {
    font-size: clamp(1.9rem, 3vw, 2.4rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }

  /* El enlace del título cubre toda la tarjeta */
  h3 a::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    content: "";
  }

  h3 a:focus-visible {
    outline: none;
  }

  .mission {
    padding-left: 14px;
    border-left: 3px solid var(--project-accent);
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-style: italic;
    line-height: 1.2;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 2px 0 14px;
  }

  .tags li {
    padding: 6px 11px;
    border-radius: 999px;
    background: var(--project-soft);
    color: var(--project-accent);
    font-size: 0.8rem;
    font-weight: 600;
  }

  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .arrow {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-family: var(--font-body);
    transition:
      transform 350ms var(--ease-out),
      background 350ms ease;
  }

  article:hover .arrow {
    background: var(--project-accent);
    transform: rotate(45deg);
  }

  /* Proyecto destacado: imagen y texto lado a lado */
  .featured {
    grid-column: 1 / -1;
  }

  @media (min-width: 900px) {
    .featured article {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }

    .featured .media {
      height: 100%;
      min-height: 360px;
      aspect-ratio: auto;
    }

    .featured .body {
      gap: 16px;
      padding: 30px 26px 14px 38px;
    }

    .featured h3 {
      font-size: clamp(2.6rem, 4.4vw, 3.6rem);
    }

    .featured .body > p:not(.mission) {
      font-size: 1.05rem;
    }
  }

  @media (max-width: 720px) {
    .projects {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media print {
    .projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    article {
      box-shadow: none;
      break-inside: avoid;
    }

    .media {
      display: none;
    }
  }
</style>
