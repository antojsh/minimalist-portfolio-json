---
import Section from "../Section.astro"

import { projects } from "@cv"

// Los proyectos activos van primero; el primero de ellos se destaca
const sortedProjects = [...projects].sort(
  (a, b) => Number(b.isActive) - Number(a.isActive)
)
---

<Section id="proyectos" title="Proyectos laborales">
  <ul class="projects">
    {
      sortedProjects.map(
        ({ url, description, highlights, name, isActive, image }, index) => {
          const isFeatured = index === 0 && isActive
          const hasCover = isFeatured && image != null

          return (
            <li class:list={{ featured: isFeatured }}>
              <article class:list={{ "has-cover": hasCover }}>
                {hasCover && (
                  <div class="cover" aria-hidden="true">
                    <img src={image} alt="" width="1118" height="628" loading="lazy" decoding="async" />
                  </div>
                )}
                {url && (
                  <span class="arrow" aria-hidden="true">
                    ↗
                  </span>
                )}

                <div class="content">
                  {isActive && <span class="status">En curso</span>}
                  <h3>
                    {url ? (
                      <a
                        href={url}
                        title={`Ver el proyecto ${name}`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {name}
                      </a>
                    ) : (
                      name
                    )}
                  </h3>
                  <p>{description}</p>
                </div>

                <ul class="tags">
                  {highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </article>
            </li>
          )
        }
      )
    }
  </ul>
</Section>

<style>
  .projects {
    display: grid;
    grid-auto-flow: dense;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .featured {
    grid-row: span 2;
    grid-column: span 2;
  }

  article {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    height: 100%;
    min-height: 250px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition:
      transform 300ms var(--ease-out),
      box-shadow 300ms var(--ease-out),
      border-color 300ms ease;
  }

  article:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  article:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .status {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    margin-bottom: 4px;
    gap: 7px;
    padding: 6px 11px;
    border-radius: 999px;
    background: rgba(28, 143, 87, 0.12);
    color: #146c41;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .status::before {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    content: "";
  }

  .arrow {
    position: absolute;
    top: 20px;
    right: 20px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--ink);
    transition:
      transform 300ms var(--ease-out),
      background 300ms ease,
      border-color 300ms ease,
      color 300ms ease;
  }

  article:hover .arrow {
    border-color: var(--ink);
    background: var(--ink);
    color: #fff;
    transform: rotate(45deg);
  }

  .content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
  }

  h3 {
    padding-right: 44px;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  /* El enlace del título cubre toda la tarjeta */
  h3 a::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    content: "";
  }

  h3 a:focus-visible {
    outline: none;
  }

  .content p {
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tags li {
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-size: 0.78rem;
    font-weight: 600;
  }

  /* Proyecto destacado en oscuro */
  .featured article {
    --pad: clamp(26px, 3.5vw, 40px);

    isolation: isolate;
    overflow: hidden;
    padding: var(--pad);
    border-color: var(--dark);
    background:
      radial-gradient(
        circle at 88% 12%,
        rgba(226, 88, 58, 0.42),
        transparent 46%
      ),
      radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.09) 1px, transparent 0)
        0 0 / 22px 22px,
      var(--dark);
    color: #fff;
  }

  .featured .content {
    justify-content: flex-end;
  }

  /* Portada de fondo: ocupa la parte superior y se funde con el fondo oscuro */
  .cover {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 60%;
    overflow: hidden;
  }

  .cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
    transition: transform 700ms var(--ease-out);
  }

  /* Fondo liso para que el degradado de la portada se funda sin costuras */
  .featured .has-cover {
    background: var(--dark);
  }

  .cover::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(21, 25, 30, 0) 45%, var(--dark));
    content: "";
  }

  .featured article:hover .cover img {
    transform: scale(1.03);
  }

  .featured h3 {
    padding-right: 0;
    color: #fff;
    font-size: clamp(2.4rem, 5vw, 3.75rem);
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .featured .content p {
    max-width: 42ch;
    color: rgba(255, 255, 255, 0.74);
    font-size: 1.1rem;
  }

  .featured .status {
    background: rgba(94, 224, 160, 0.14);
    color: #6ee7b0;
  }

  .featured .arrow {
    top: var(--pad);
    right: var(--pad);
    border-color: rgba(255, 255, 255, 0.24);
    background: rgba(21, 25, 30, 0.72);
    color: #fff;
    backdrop-filter: blur(6px);
  }

  .featured article:hover .arrow {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--ink);
  }

  .featured .tags li {
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
  }

  @media (prefers-reduced-motion: no-preference) {
    .status::before {
      animation: status-blink 1.8s ease-in-out infinite;
    }
  }

  @keyframes status-blink {
    50% {
      opacity: 0.35;
    }
  }

  @media (max-width: 900px) {
    .projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .featured {
      grid-row: auto;
    }

    .featured article {
      min-height: 340px;
    }

    /* La portada se apila arriba, a sangre, y el texto va debajo */
    .cover {
      position: relative;
      z-index: auto;
      height: auto;
      margin: calc(var(--pad) * -1) calc(var(--pad) * -1) 0;
      aspect-ratio: 16 / 9;
    }

    /* Si queda una tarjeta sola en la última fila, ocupa todo el ancho */
    .projects > li:last-child:nth-child(even) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .projects {
      grid-template-columns: minmax(0, 1fr);
    }

    .featured {
      grid-column: auto;
    }

    article {
      min-height: 0;
    }
  }

  @media print {
    .projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    article {
      min-height: 0;
      box-shadow: none;
      break-inside: avoid;
    }

    .featured article,
    .featured .has-cover {
      min-height: 0;
      border-color: var(--line);
      background: #fff;
      color: var(--text);
    }

    .cover,
    .arrow {
      display: none;
    }

    .featured h3 {
      color: var(--ink);
      font-size: 1.8rem;
    }

    .featured .content p {
      color: var(--text-soft);
    }

    .featured .tags li {
      border: 0;
      background: var(--accent-soft);
      color: var(--accent-ink);
    }

    .featured .status {
      background: rgba(28, 143, 87, 0.12);
      color: #146c41;
    }
  }
</style>
