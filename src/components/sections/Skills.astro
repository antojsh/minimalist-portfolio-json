---
import Section from "../Section.astro"

import { skills } from "@cv"
---

<Section title="Herramientas">
  <ul>
    {
      skills.map(({ name }) => (
        <li>
          <span>{name}</span>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  ul {
    display: inline-flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  li {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.76rem;
    font-weight: 500;
    padding: 0.35rem 0.7rem;
  }
</style>
