---
import { basics } from "@cv"

interface Props {
  title: string
}

const { title } = Astro.props
const description =
  "Portafolio de Antonio Sierra Hurtado, desarrollador frontend especializado en interfaces, sistemas de diseño y productos digitales."
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f3ed" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={basics.image} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Instrument+Serif:ital@1&family=Inter:wght@400..700&family=JetBrains+Mono:wght@400..600&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --background: #f6f3ed;
    --surface: #ffffff;
    --ink: #15191e;
    --text: #29313a;
    --text-soft: #4b5661;
    --muted: #616c76;
    --line: #e4ddd1;
    --line-strong: #cfc5b5;
    --accent: #e2583a;
    --accent-ink: #b33f20;
    --accent-soft: #fbe5da;
    --success: #1c8f57;
    --dark: #15191e;

    --font-display: "Bricolage Grotesque", "Inter", ui-sans-serif, system-ui,
      sans-serif;
    --font-body: "Inter", ui-sans-serif, system-ui, -apple-system,
      BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo,
      Consolas, monospace;
    --font-serif: "Instrument Serif", Georgia, "Times New Roman", serif;

    --radius-md: 16px;
    --radius-lg: 24px;
    --shadow-sm: 0 1px 2px rgba(21, 25, 30, 0.05);
    --shadow-lg: 0 30px 60px -32px rgba(21, 25, 30, 0.3);
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  }

  html {
    background: var(--background);
    color: var(--text);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  body,
  figure {
    margin: 0;
    padding: 0;
  }

  body {
    position: relative;
    isolation: isolate;
    min-width: 320px;
    overflow-x: clip;
    background: var(--background);
  }

  /* Lienzo del encabezado: retícula de puntos y luz cálida que se desvanecen */
  body::before {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 1100px;
    background:
      radial-gradient(
        42rem 30rem at 82% 6%,
        rgba(226, 88, 58, 0.16),
        transparent 70%
      ),
      radial-gradient(
        36rem 26rem at 6% 0%,
        rgba(255, 186, 120, 0.22),
        transparent 70%
      ),
      radial-gradient(circle at 1px 1px, rgba(21, 25, 30, 0.13) 1px, transparent 0)
        0 0 / 24px 24px;
    mask-image: linear-gradient(to bottom, #000 30%, transparent);
    pointer-events: none;
    content: "";
  }

  a {
    color: inherit;
    text-decoration: none;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background 180ms ease;
  }

  ul,
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  img {
    max-width: 100%;
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    text-wrap: balance;
  }

  p {
    margin: 0;
    color: var(--text-soft);
    font-size: 1rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  ::selection {
    background: var(--accent-soft);
    color: var(--ink);
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Las secciones aparecen al entrar en pantalla (solo donde el navegador lo soporta) */
  @keyframes reveal-up {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .reveal {
        animation: reveal-up linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 40%;
      }
    }
  }

  .print {
    display: none !important;
  }

  @media print {
    @page {
      margin: 14mm 12mm;
    }

    html,
    body {
      background: #fff;
    }

    html {
      font-size: 13px;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }

    body::before {
      display: none;
    }

    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
    }

    .no-print {
      display: none !important;
    }

    .print {
      display: block !important;
    }
  }
</style>
