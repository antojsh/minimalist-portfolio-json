---
import Layout from "@/layouts/Layout.astro";
import "@/styles/tools.css";
import Topbar from "@/components/tool/Topbar.astro";
import Faq from "@/components/tool/Faq.astro";
import Colophon from "@/components/tool/Colophon.astro";
import { DECLARATION_YEAR, TAXABLE_YEAR, THRESHOLDS, thresholdPesos } from "@/lib/renta";
import {
    CERTIFICATES_DUE,
    DEADLINE_MONTHS,
    FIRST_DEADLINE,
    GLOBAL_LIMIT,
    LAST_DEADLINE,
    MIN_PENALTY,
    RELIEFS,
    RENTA_2027_PUBLISHED,
    RENTA_2027_REVIEW,
    STATUS,
    TIMELINE,
    UVT_TAXABLE,
    formatDay,
    shortDay,
} from "@/lib/renta-2027";
import { RESCATE_STATUS, TABLE_241_NOW, firstTaxedSalary, rentaFor } from "@/lib/ley-rescate";
import { formatCOP, formatNumber } from "@/lib/uvt";
import { articleJsonLd, longDate } from "@/lib/seo";

const DECREE_URL = "https://normograma.dian.gov.co/dian/compilacion/docs/decreto_2229_2023.htm";
const UVT_URL = "https://normograma.dian.gov.co/dian/compilacion/docs/resolucion_dian_0238_2025.htm";
const COURT_URL = "https://incp.org.co/publicaciones/2026/04/corte-constitucional-declaro-inexequible-el-decreto-legislativo-1474-de-2025/";

const pct = (value: number) => `${(value * 100).toLocaleString("es-CO", { maximumFractionDigits: 1 })} %`;
const num = (value: number, digits = 1) => value.toLocaleString("es-CO", { maximumFractionDigits: digits });
const uvtPesos = (uvt: number) => formatCOP(uvt * UVT_TAXABLE.value);

const income = thresholdPesos(1_400);
const wealth = thresholdPesos(4_500);
const monthlyIncome = Math.ceil(income / 12);
const firstTaxed = firstTaxedSalary("now");
const known = STATUS.filter((item) => item.known);
const pending = STATUS.filter((item) => !item.known);

// Escala de la gráfica "declarar no es pagar": de $0 a un poco más del doble del tope mensual
const scaleMax = Math.ceil((firstTaxed * 1.7) / 1_000_000) * 1_000_000;
const zones = [
    { id: "free", label: "No declaras", detail: `Menos de ${formatCOP(monthlyIncome)} al mes`, width: monthlyIncome / scaleMax },
    { id: "file", label: "Declaras, pero no pagas", detail: `Entre ${formatCOP(monthlyIncome)} y ${formatCOP(firstTaxed)}`, width: (firstTaxed - monthlyIncome) / scaleMax },
    { id: "pay", label: "Declaras y pagas", detail: `Desde unos ${formatCOP(firstTaxed)} al mes`, width: (scaleMax - firstTaxed) / scaleMax },
];

// Valores de arranque de la calculadora (la página se ve completa sin JavaScript)
const SAMPLE = 8_000_000;
const sample = rentaFor(SAMPLE, 0, "now");

const tableRows = TABLE_241_NOW.map(({ from, to, rate }) => ({
    range: to === Infinity ? `Más de ${formatNumber(from)}` : from === 0 ? `Hasta ${formatNumber(to)}` : `${formatNumber(from)} a ${formatNumber(to)}`,
    pesos: to === Infinity ? `Más de ${uvtPesos(from)}` : from === 0 ? `Hasta ${uvtPesos(to)}` : `${uvtPesos(from)} a ${uvtPesos(to)}`,
    rate: rate ? pct(rate) : "0 %",
}));

const documents = [
    { title: "RUT actualizado", text: "Con la responsabilidad 05 (renta). Si no lo tienes, se saca gratis en el portal de la DIAN." },
    { title: "Certificado de ingresos y retenciones", text: `El formulario 220 que te da tu empleador a más tardar el ${formatDay(CERTIFICATES_DUE)}.` },
    { title: "Certificados de bancos", text: `Saldos al 31 de diciembre de ${TAXABLE_YEAR}, intereses que te pagaron y 4x1000 que te cobraron.` },
    { title: "Certificados de deudas", text: "Saldo de créditos al 31 de diciembre e intereses pagados del crédito de vivienda." },
    { title: "Pensión, cesantías y aportes voluntarios", text: "Saldos de cesantías, certificados de pensión voluntaria y cuentas AFC." },
    { title: "Valor de tus bienes", text: `Avalúo catastral de inmuebles y valor de tus vehículos. Van en el patrimonio de ${TAXABLE_YEAR}.` },
    { title: "Medicina prepagada y dependientes", text: "Certificados de pagos y los soportes de quienes dependen de ti." },
    { title: "Información exógena", text: "Lo que terceros reportaron de ti. Se consulta en el portal de la DIAN y tu declaración debe cuadrar con eso." },
];

const mistakes = [
    { title: "Mirar el sueldo neto", text: "El tope es sobre ingresos brutos: lo que te pagan antes de descontar salud, pensión o retención." },
    { title: "Restar las deudas al patrimonio", text: "El tope de patrimonio es bruto. Un apartamento hipotecado cuenta por su valor completo." },
    { title: "Usar la UVT equivocada", text: `Para saber si declaras en ${DECLARATION_YEAR} se usa la UVT de ${TAXABLE_YEAR} (${formatCOP(UVT_TAXABLE.value)}), no la de ${DECLARATION_YEAR}.` },
    { title: "Creer que con la retención basta", text: "La retención es un anticipo. Si superas un tope, igual tienes que presentar la declaración." },
    { title: "Olvidar las consignaciones", text: "Entran las transferencias que te hicieron, aunque sean de familia o devoluciones, y lo que pusiste en CDT o fondos." },
    { title: "Contar el dígito de verificación", text: "Tu fecha sale de los dos últimos dígitos del NIT sin el dígito que va después del guion." },
];

const faqs = [
    {
        question: `¿Cuándo hay que declarar renta en ${DECLARATION_YEAR}?`,
        answer: `Entre el ${formatDay(FIRST_DEADLINE.date)} y el ${formatDay(LAST_DEADLINE.date)} de ${DECLARATION_YEAR}, según los dos últimos dígitos de tu cédula o NIT, sin el dígito de verificación. Las fechas salen del Decreto 2229 de 2023, que fija los plazos en días hábiles para todos los años; la DIAN suele publicar el calendario oficial a finales de diciembre.`,
    },
    {
        question: `¿Quién debe declarar renta en ${DECLARATION_YEAR}?`,
        answer: `Las personas naturales residentes que en ${TAXABLE_YEAR} tuvieron ingresos brutos de ${formatCOP(income)} o más, un patrimonio bruto de más de ${formatCOP(wealth)} al 31 de diciembre, o compras, consumos con tarjeta de crédito o consignaciones de más de ${formatCOP(income)} en el año. También quienes eran responsables de IVA al cierre del año. Con superar un solo tope ya estás obligado.`,
    },
    {
        question: `¿La declaración de renta ${DECLARATION_YEAR} es sobre lo que gane en ${DECLARATION_YEAR}?`,
        answer: `No. En ${DECLARATION_YEAR} declaras lo que ganaste y lo que tenías en ${TAXABLE_YEAR}, que es el año gravable. Lo que ganes en ${DECLARATION_YEAR} se declara en ${DECLARATION_YEAR + 1}.`,
    },
    {
        question: `¿Ya salió el calendario de renta ${DECLARATION_YEAR}?`,
        answer: `Las fechas ya se pueden calcular: el Decreto 2229 de 2023 dice en qué día hábil de agosto, septiembre y octubre vence cada par de dígitos, y con los festivos de ${DECLARATION_YEAR} eso da del ${formatDay(FIRST_DEADLINE.date)} al ${formatDay(LAST_DEADLINE.date)}. Lo que falta es la publicación oficial de la DIAN, que normalmente confirma esas mismas fechas. Solo cambiarían si el Gobierno expide un decreto nuevo.`,
    },
    {
        question: `¿Qué UVT se usa para la declaración de renta ${DECLARATION_YEAR}?`,
        answer: `La de ${TAXABLE_YEAR}: ${formatCOP(UVT_TAXABLE.value)} (${UVT_TAXABLE.resolution}). Con ella se calculan los topes, la tabla del impuesto y los límites de las deducciones. La UVT de ${DECLARATION_YEAR} solo se usa para las sanciones que se liquiden en ${DECLARATION_YEAR}.`,
    },
    {
        question: `¿La Ley de Rescate Económico cambia la declaración de ${DECLARATION_YEAR}?`,
        answer: `No. La tabla nueva de renta del proyecto, con el tramo del 9 %, y la eliminación de la deducción de 72 UVT por dependiente aplicarían desde el año gravable ${DECLARATION_YEAR}, que se declara en ${DECLARATION_YEAR + 1}. Lo que declaras en ${DECLARATION_YEAR} sigue las reglas de la Ley 2277 de 2022.`,
    },
    {
        question: "Si me hicieron retención en la fuente, ¿igual tengo que declarar?",
        answer: "Sí, si superas algún tope. La retención es un pago por adelantado del impuesto. Al declarar se resta, y muchas veces el resultado es cero o un saldo a favor que puedes pedir que te devuelvan.",
    },
    {
        question: `¿Desde qué sueldo se paga renta en ${DECLARATION_YEAR}?`,
        answer: `Un empleado con salario fijo, sin otros ingresos ni deducciones, empieza a tener impuesto con un sueldo de unos ${formatCOP(firstTaxed)} al mes en ${TAXABLE_YEAR}. Quien ganó entre ${formatCOP(monthlyIncome)} y esa cifra tiene que declarar, pero el impuesto le da cero.`,
    },
    {
        question: "¿Qué formulario se usa?",
        answer: `El formulario 210, para personas naturales residentes. La DIAN publica la versión del año gravable ${TAXABLE_YEAR} en los primeros meses de ${DECLARATION_YEAR} y ofrece una declaración sugerida con la información que reportaron bancos y empresas.`,
    },
    {
        question: "¿Qué pasa si declaro tarde?",
        answer: `Pagas una sanción por extemporaneidad del 5 % del impuesto por cada mes o fracción de retraso, hasta el 100 %, más intereses de mora sobre lo que no pagaste a tiempo. Si no tienes impuesto a cargo, la sanción se calcula sobre tus ingresos brutos. Ninguna sanción puede ser menor a 10 UVT, que en ${DECLARATION_YEAR} serán ${MIN_PENALTY.estimated ? "unos " : ""}${formatCOP(MIN_PENALTY.value)}.`,
    },
];

const site = Astro.site?.href ?? "/";
const path = "/blog/declaracion-de-renta-2027";
const title = `Declaración de renta ${DECLARATION_YEAR}: fechas, topes y todo lo que ya se sabe`;
const description = `Guía de la declaración de renta ${DECLARATION_YEAR} (año gravable ${TAXABLE_YEAR}): quién declara, topes en pesos, fechas por cédula, cuánto pagarías y qué falta por confirmar.`;
const ogPath = "/og/declaracion-de-renta-2027.png";
const jsonLd = articleJsonLd({
    site,
    path,
    title,
    description,
    crumb: `Declaración de renta ${DECLARATION_YEAR}`,
    published: RENTA_2027_PUBLISHED,
    modified: RENTA_2027_REVIEW,
    image: ogPath,
    keywords: [
        `declaración de renta ${DECLARATION_YEAR}`,
        `renta ${DECLARATION_YEAR}`,
        `calendario renta ${DECLARATION_YEAR}`,
        `topes renta ${DECLARATION_YEAR}`,
        `año gravable ${TAXABLE_YEAR}`,
        "personas naturales",
        "formulario 210",
        `UVT ${TAXABLE_YEAR}`,
    ],
    faqs,
});
---

<Layout title={title} description={description} image={ogPath} imageAlt={`Declaración de renta ${DECLARATION_YEAR}: lo que ya se sabe`} imageWidth={1200} imageHeight={630} canvas={false} type="article" jsonLd={jsonLd}>
    <div class="tool-flag" aria-hidden="true"></div>

    <main class="tool post">
        <Topbar
            parent={{ href: "/blog", label: "Blog" }}
            crumb={`Renta ${DECLARATION_YEAR}`}
            links={[
                { href: "#resumen", label: "Resumen" },
                { href: "#topes", label: "Topes" },
                { href: "#fechas", label: "Fechas" },
                { href: "#cuanto", label: "Cuánto pagas" },
                { href: "#reforma", label: "Reforma" },
                { href: "#preguntas", label: "Preguntas" },
            ]}
        />

        <header class="hero">
            <p class="kicker">Impuestos explicados fácil</p>
            <h1>Declaración de renta {DECLARATION_YEAR}, <span>lo que ya se sabe</span></h1>
            <p class="lead">
                Falta casi un año, pero lo más importante <strong>ya se puede calcular</strong>: en {DECLARATION_YEAR} declaras lo que
                ganaste en {TAXABLE_YEAR}, con topes en pesos que no van a cambiar y fechas que salen de un decreto vigente. Aquí está todo,
                sin enredos, y lo poco que todavía depende de la DIAN.
            </p>
            <p class="updated">
                Por <a href="/">Antonio Sierra</a> · <time datetime={RENTA_2027_PUBLISHED}>{longDate(RENTA_2027_PUBLISHED)}</time>
                {RENTA_2027_REVIEW !== RENTA_2027_PUBLISHED && <> · Revisado el <time datetime={RENTA_2027_REVIEW}>{longDate(RENTA_2027_REVIEW)}</time></>}
                · Lectura de 12 minutos
            </p>
        </header>

        <section id="resumen" aria-labelledby="resumen-titulo">
            <header class="head">
                <h2 id="resumen-titulo">Si solo tienes un minuto</h2>
                <p>Lo esencial de la declaración de renta {DECLARATION_YEAR} para personas naturales.</p>
            </header>
            <ul class="facts">
                <li>
                    <b>{formatCOP(income)}</b>
                    <span>Ingresos brutos en {TAXABLE_YEAR} desde los que declaras. Unos {formatCOP(monthlyIncome)} al mes.</span>
                </li>
                <li>
                    <b>{formatCOP(wealth)}</b>
                    <span>Patrimonio bruto al 31 de diciembre de {TAXABLE_YEAR}. Si lo superas, declaras aunque no hayas ganado nada.</span>
                </li>
                <li>
                    <b>{shortDay(FIRST_DEADLINE.date)} - {shortDay(LAST_DEADLINE.date)}</b>
                    <span>Plazos de {DECLARATION_YEAR}, según los dos últimos dígitos de tu cédula. <a href="/declarar-renta#calendario">Busca tu fecha</a>.</span>
                </li>
                <li>
                    <b>{formatCOP(UVT_TAXABLE.value)}</b>
                    <span>UVT de {TAXABLE_YEAR}. Es la que cuenta para los topes y la tabla, no la de {DECLARATION_YEAR}.</span>
                </li>
                <li>
                    <b>{formatCOP(firstTaxed)}</b>
                    <span>Sueldo mensual desde el que un empleado sin deducciones empieza a pagar impuesto. Declarar no siempre es pagar.</span>
                </li>
                <li>
                    <b>Sin cambios</b>
                    <span>La Ley de Rescate no toca esta declaración: su tabla nueva aplicaría a lo que ganes en {DECLARATION_YEAR}.</span>
                </li>
            </ul>

            <nav class="index" aria-label="Contenido del artículo">
                <p>Lo que vas a encontrar</p>
                <ul>
                    <li><a href="#que-es">Qué significa “renta {DECLARATION_YEAR}”</a></li>
                    <li><a href="#estado">Lo que ya se sabe y lo que falta</a></li>
                    <li><a href="#topes">Quién tiene que declarar</a></li>
                    <li><a href="#fechas">Fechas por cédula</a></li>
                    <li><a href="#linea">El año de la renta, mes a mes</a></li>
                    <li><a href="#cuanto">Cuánto pagarías, con calculadora</a></li>
                    <li><a href="#restar">Lo que puedes restar</a></li>
                    <li><a href="#documentos">Qué documentos ir guardando</a></li>
                    <li><a href="#reforma">La Ley de Rescate y el decreto que se cayó</a></li>
                    <li><a href="#errores">Errores comunes y sanciones</a></li>
                </ul>
            </nav>
        </section>

        <section id="que-es" aria-labelledby="que-es-titulo">
            <header class="head">
                <h2 id="que-es-titulo">“Renta {DECLARATION_YEAR}” es sobre lo que pasó en {TAXABLE_YEAR}</h2>
                <p>La confusión más común, resuelta en un párrafo.</p>
            </header>
            <div class="split">
                <div class="prose">
                    <p>
                        La declaración de renta mira hacia atrás. En {DECLARATION_YEAR} le cuentas a la DIAN <strong>cuánto ganaste, cuánto
                        gastaste y qué tenías en {TAXABLE_YEAR}</strong>. A ese año se le llama <dfn>año gravable</dfn>. Por eso, cuando alguien
                        busca “renta {DECLARATION_YEAR}”, lo que importa son los números de {TAXABLE_YEAR}, y esos ya están casi completos.
                    </p>
                    <p>
                        Declarar es presentar un formulario, el <strong>210</strong>, con tus ingresos, tu patrimonio y tus deudas. De ahí sale un
                        impuesto que puede dar cero, un valor a pagar o un <dfn>saldo a favor</dfn> si te retuvieron de más durante el año.
                    </p>
                    <p>
                        Solo declaran las personas que superan algún tope, y se mide con la <dfn>UVT</dfn>, una unidad que la DIAN actualiza cada año
                        con la inflación. La de {TAXABLE_YEAR} vale {formatCOP(UVT_TAXABLE.value)} desde diciembre del año pasado, así que los topes en
                        pesos ya son definitivos.
                    </p>
                </div>
                <aside class="analogy">
                    <p class="analogy-head">Piénsalo como el boletín del colegio</p>
                    <p>
                        Las notas del año se entregan cuando el año ya terminó. Nadie te califica en enero por lo que vas a estudiar; te califican
                        por lo que hiciste. La renta funciona igual: <strong>en {DECLARATION_YEAR} entregas el boletín de {TAXABLE_YEAR}</strong>, y
                        lo que hagas en {DECLARATION_YEAR} va en el boletín de {DECLARATION_YEAR + 1}.
                    </p>
                </aside>
            </div>
        </section>

        <section id="estado" aria-labelledby="estado-titulo">
            <header class="head">
                <h2 id="estado-titulo">Lo que ya se sabe y lo que falta</h2>
                <p>Lo que decide si declaras y cuánto pagas ya está en firme. Lo pendiente es papeleo de la DIAN.</p>
            </header>
            <div class="board">
                <div class="board-col">
                    <p class="board-head known">Confirmado</p>
                    <ul>
                        {
                            known.map(({ label, detail }) => (
                                <li class="known">
                                    <span class="mark" aria-hidden="true">✓</span>
                                    <div>
                                        <b>{label}</b>
                                        <p>{detail}</p>
                                    </div>
                                </li>
                            ))
                        }
                    </ul>
                </div>
                <div class="board-col">
                    <p class="board-head">Por confirmar</p>
                    <ul>
                        {
                            pending.map(({ label, detail }) => (
                                <li>
                                    <span class="mark" aria-hidden="true"></span>
                                    <div>
                                        <b>{label}</b>
                                        <p>{detail}</p>
                                    </div>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </section>

        <section id="topes" aria-labelledby="topes-titulo">
            <header class="head">
                <h2 id="topes-titulo">¿Quién tiene que declarar renta en {DECLARATION_YEAR}?</h2>
                <p>Basta con superar <strong>uno solo</strong> de estos topes en {TAXABLE_YEAR}.</p>
            </header>
            <div class="split">
                <div class="table-wrap">
                    <table class="amounts">
                        <caption>Topes del año gravable {TAXABLE_YEAR} (arts. 592, 593 y 594-3 del Estatuto Tributario)</caption>
                        <thead>
                            <tr>
                                <th scope="col">Tope</th>
                                <th scope="col" class="num">UVT</th>
                                <th scope="col" class="num">En pesos</th>
                            </tr>
                        </thead>
                        <tbody>
                            {
                                THRESHOLDS.map(({ label, uvt: limit, inclusive, key }) => (
                                    <tr>
                                        <th scope="row">
                                            {label}
                                            <small>{key === "patrimonio" ? `Al 31 de diciembre, sin restar deudas` : "En todo el año"}</small>
                                        </th>
                                        <td class="num">{inclusive ? "Desde" : "Más de"} {formatNumber(limit)}</td>
                                        <td class="num strong">{formatCOP(thresholdPesos(limit))}</td>
                                    </tr>
                                ))
                            }
                            <tr>
                                <th scope="row">
                                    Responsable de IVA
                                    <small>Al 31 de diciembre de {TAXABLE_YEAR}</small>
                                </th>
                                <td class="num">-</td>
                                <td class="num strong">Siempre declara</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="prose">
                    <p>
                        Los topes aplican a las personas naturales <dfn>residentes</dfn>: quienes estuvieron más de 183 días en Colombia en un
                        periodo de un año, o tienen aquí a su familia o la mayor parte de sus bienes.
                    </p>
                    <ul>
                        <li><strong>Ingresos brutos</strong> son todos: salario, honorarios, arriendos, intereses, pensión, ventas. Antes de cualquier descuento.</li>
                        <li><strong>Patrimonio bruto</strong> es lo que valían tus cosas el 31 de diciembre: casa, carro, ahorros, inversiones, cesantías. Sin restar deudas.</li>
                        <li><strong>Consignaciones</strong> incluye las transferencias que recibiste y lo que pusiste en CDT, fondos o inversiones.</li>
                    </ul>
                    <p>
                        ¿Quieres revisarlo con tus números? En <a href="/declarar-renta">¿Debo declarar renta?</a> pones tus cifras de
                        {TAXABLE_YEAR} y te dice si declaras y cuál es tu fecha límite.
                    </p>
                </div>
            </div>

            <figure class="chart zones-chart">
                <figcaption>
                    <b>Declarar no es lo mismo que pagar</b>
                    <span>Empleado con salario fijo en {TAXABLE_YEAR}, sin otros ingresos ni deducciones</span>
                </figcaption>
                <div class="zones" role="img" aria-label={zones.map(({ label, detail }) => `${label}: ${detail}`).join(". ")}>
                    {zones.map(({ id, width }) => <span class={`zone ${id}`} style={`--w: ${width}`}></span>)}
                </div>
                <div class="zones-scale" aria-hidden="true">
                    <span>$0</span>
                    <span>{formatCOP(scaleMax)} al mes</span>
                </div>
                <ul class="zones-legend">
                    {
                        zones.map(({ id, label, detail }) => (
                            <li>
                                <i class={`swatch ${id}`}></i>
                                <span>
                                    <b>{label}</b>
                                    {detail}
                                </span>
                            </li>
                        ))
                    }
                </ul>
                <p class="chart-note">
                    Por debajo de {formatCOP(firstTaxed)} al mes, lo que queda después de aportes y de la renta exenta del 25&nbsp;% cae en el
                    tramo del 0&nbsp;%. Igual tienes que presentar la declaración si pasaste el tope de ingresos.
                </p>
            </figure>
        </section>

        <section id="fechas" aria-labelledby="fechas-titulo">
            <header class="head">
                <h2 id="fechas-titulo">Fechas de la declaración de renta {DECLARATION_YEAR}</h2>
                <p>
                    Del {formatDay(FIRST_DEADLINE.date)} al {formatDay(LAST_DEADLINE.date)}. Se presenta y se paga el mismo día, según los dos
                    últimos dígitos de tu cédula.
                </p>
            </header>
            <ol class="months">
                {
                    DEADLINE_MONTHS.map(({ month, from, to }) => (
                        <li>
                            <p class="months-name">{month.charAt(0).toUpperCase() + month.slice(1)}</p>
                            <p class="months-digits">
                                Dígitos <b>{from.digits.slice(0, 2)}</b> a <b>{to.digits.slice(3)}</b>
                            </p>
                            <p class="months-dates">
                                Del {Number(from.date.slice(8))} al {Number(to.date.slice(8))} de {month}
                            </p>
                        </li>
                    ))
                }
            </ol>
            <div class="split narrow">
                <div class="prose">
                    <p>
                        ¿Por qué se pueden saber desde ya? Porque el <a href={DECREE_URL} rel="noopener">Decreto 2229 de 2023</a> dejó de fijar
                        fechas exactas y las fijó en <strong>días hábiles</strong>: los dígitos 01-02 vencen el séptimo día hábil de agosto, y así
                        sucesivamente hasta los 99-00, el décimo séptimo día hábil de octubre. Con los festivos de {DECLARATION_YEAR}, eso da estas
                        fechas. Con la misma regla, el calendario de este sitio coincidió con el que publicó la DIAN para {TAXABLE_YEAR}.
                    </p>
                    <p>
                        Para encontrar tu día, toma tu cédula sin el dígito de verificación y mira los dos últimos números. Si tu cédula termina en
                        …4537, buscas el 37.
                    </p>
                </div>
                <a class="cta" href="/declarar-renta#calendario">
