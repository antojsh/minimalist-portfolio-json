<script>
    import { rentaFor } from "@/lib/ley-rescate";
    import { thresholdPesos } from "@/lib/renta";
    import { formatCOP, formatNumber, parseCOP } from "@/lib/uvt";

    const pct = (value: number) => `${(value * 100).toLocaleString("es-CO", { maximumFractionDigits: 1 })} %`;
    const incomeLimit = thresholdPesos(1_400);

    const root = document.querySelector<HTMLElement>('[data-calc="renta"]');
    if (root) {
        const form = root.querySelector<HTMLFormElement>("[data-form]")!;
        const live = root.querySelector<HTMLElement>("[data-live]")!;
        const salaryInput = form.elements.namedItem("salario") as HTMLInputElement;
        const dependentsInput = form.elements.namedItem("dependientes") as HTMLSelectElement;
        const out = (key: string) => root.querySelector<HTMLElement>(`[data-out="${key}"]`)!;
        const line = (key: string) => root.querySelector<HTMLElement>(`[data-line="${key}"]`)!;

        const run = () => {
            const salary = parseCOP(salaryInput.value);
            const result = rentaFor(salary, Number(dependentsInput.value), "now");
            out("must").textContent = salary * 12 >= incomeLimit ? "Sí, por ingresos" : "No por ingresos";
            out("bracket").textContent = result.tax ? pct(result.bracket.rate) : "0 %";
            out("tax").textContent = formatCOP(result.tax);
            out("month").textContent = formatCOP(Math.round(result.tax / 12));
            for (const key of ["income", "health", "pension", "solidarity", "exempt", "dependents"] as const) {
                line(key).textContent = formatCOP(Math.round(result[key]));
            }
            line("uvt").textContent = result.taxableUvt.toLocaleString("es-CO", { maximumFractionDigits: 1 });
            live.textContent = `Impuesto del año: ${formatCOP(result.tax)}.`;
        };

        salaryInput.addEventListener("input", () => {
            const value = parseCOP(salaryInput.value);
            salaryInput.value = value ? formatNumber(value) : "";
        });
        for (const chip of root.querySelectorAll<HTMLButtonElement>("[data-amount]")) {
            chip.addEventListener("click", () => {
                salaryInput.value = formatNumber(Number(chip.dataset.amount));
                run();
            });
        }
        form.addEventListener("input", run);
        form.addEventListener("change", run);
        run();
    }
</script>

