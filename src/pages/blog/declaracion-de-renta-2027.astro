                            <th scope="col">Cómo funciona</th>
                            <th scope="col" class="num">Tope al año</th>
                            <th scope="col">Soporte</th>
                        </tr>
                    </thead>
                    <tbody>
                        {
                            RELIEFS.map(({ label, rule, capUvt, outsideLimit, paper }) => (
