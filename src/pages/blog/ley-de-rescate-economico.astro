---
import Layout from "@/layouts/Layout.astro";
import "@/styles/tools.css";
import Topbar from "@/components/tool/Topbar.astro";
import Faq from "@/components/tool/Faq.astro";
import Colophon from "@/components/tool/Colophon.astro";
import {
    EFECTIVA_CAP_UVT,
    FISCAL,
    GDP_2027,
    HEALTH_ROWS,
    IVA_GROUPS,
    POPULATION,
    RESCATE_PUBLISHED,
    RESCATE_REVIEW,
    RESCATE_STATUS,
    TABLE_241_NEW,
    TABLE_241_NOW,
    UVT_2026,
    VICES,
    WAGE_2026,
    firstTaxedSalary,
    healthNew,
    healthNow,
    newPrice,
    rentaFor,
} from "@/lib/ley-rescate";
import { formatCOP, formatNumber } from "@/lib/uvt";
import { articleJsonLd, longDate } from "@/lib/seo";

const pct = (value: number) => `${(value * 100).toLocaleString("es-CO", { maximumFractionDigits: 1 })} %`;
const num = (value: number, digits = 1) => value.toLocaleString("es-CO", { maximumFractionDigits: digits });
const uvtPesos = (uvt: number) => formatCOP(uvt * UVT_2026);
/** 9.4 → "$9,40" */
const cents = (value: number) => `$${value.toFixed(2).replace(".", ",")}`;

const firstNow = firstTaxedSalary("now");
const firstNew = firstTaxedSalary("new");
const deficitPesos = (GDP_2027 * FISCAL.deficit2027) / 100;
const perPerson = (deficitPesos * 1e12) / POPULATION;

// Valores de arranque de las calculadoras (la página se ve completa sin JavaScript)
const RENTA_SAMPLE = 6_000_000;
const rentaNow = rentaFor(RENTA_SAMPLE, 0, "now");
const rentaNew = rentaFor(RENTA_SAMPLE, 0, "new");
const HEALTH_SAMPLE = 5_000_000;
const ivaToday = IVA_GROUPS.reduce((sum, group) => sum + group.sample, 0);
const ivaAfter = IVA_GROUPS.reduce((sum, group) => sum + newPrice(group.sample, group.from, group.to), 0);
const vice = VICES[0];

const tableRows = (table: typeof TABLE_241_NOW) =>
    table.map(({ from, to, rate, plus }) => ({
        range: to === Infinity ? `Más de ${formatNumber(from)}` : from === 0 ? `Hasta ${formatNumber(to)}` : `${formatNumber(from)} a ${formatNumber(to)}`,
        rate: rate ? pct(rate) : "0 %",
        plus,
    }));

const faqs = [
    {
        question: "¿La Ley de Rescate Económico ya es ley?",
        answer: "No. Es el Proyecto de Ley 477 de 2026, radicado en la Cámara el 29 de octubre de 2026. El Gobierno pidió trámite de urgencia para que las comisiones económicas de Cámara y Senado lo discutan juntas. Para que rija en 2027 debe aprobarse antes de que termine la legislatura, el 16 de diciembre, y en el camino el Congreso puede cambiarlo.",
    },
    {
        question: "¿Cuándo empezaría a aplicar?",
        answer: "Por partes. Los cambios en salud y parafiscales arrancarían el 1 de enero de 2027. El IVA de licores, compras internacionales de menos de US$200 y apuestas en línea, apenas entre en vigencia. El IVA de la canasta (frutas, verduras, café, azúcar, aceite) desde el 1 de enero de 2028. La nueva tabla de renta aplicaría al año gravable 2027, que se declara en 2028.",
    },
    {
        question: "¿Sube el IVA del arroz, la carne, los huevos o la leche?",
        answer: "No. Según el proyecto, carne, pollo, pescado, leche, huevos, arroz, papa, yuca, pan, arepa y panela siguen sin IVA, igual que el agua, el gas y la luz. Lo que sube a 19 % desde 2028 son las frutas, verduras y hortalizas, y los productos que hoy pagan 5 %, como café, azúcar, aceite, pastas y chocolate.",
    },
    {
        question: "¿Desde qué sueldo pagaría impuesto de renta?",
        answer: `Con la tabla actual, un empleado sin otros ingresos ni deducciones empieza a pagar renta con un sueldo de unos ${formatCOP(firstNow)} al mes. Con la tabla del proyecto, desde unos ${formatCOP(firstNew)}, porque aparece un tramo nuevo del 9 % que arranca en 720 UVT de renta líquida al año. Las cuentas van en pesos de 2026.`,
    },
    {
        question: "¿Cuánto más me descontarían de salud?",
        answer: "Quien gana hasta 2 salarios mínimos sigue pagando 4 %. De ahí en adelante el aporte sube por escalones: 5,5 % entre 2 y 4 mínimos, 6 % entre 4 y 5, 6,5 % entre 5 y 10, y así hasta 8 % para quien gana entre 20 y 25 mínimos. Los independientes pasarían de 12,5 % a entre 13 % y 15,5 %. Arrancaría el 1 de enero de 2027.",
    },
    {
        question: "¿Qué es EfectIVA?",
        answer: `Es el mecanismo con el que el proyecto devolvería el IVA a los hogares de menos ingresos desde 2028: el 100 % a las personas en pobreza y entre el 30 % y el 50 % a la población vulnerable, con un tope de ${num(EFECTIVA_CAP_UVT)} UVT por persona al mes. El Gobierno calcula que cubriría a unos 19 millones de personas con devolución total.`,
    },
    {
        question: "¿La plata sale de recortes o de impuestos?",
        answer: "Depende de quién haga la cuenta. El Gobierno dice que siete de cada diez pesos del ajuste salen del gasto. Análisis como el de La Silla Vacía o Citi encuentran que los recortes directos son entre una quinta y una cuarta parte, porque el Gobierno cuenta como menor gasto el quitar beneficios tributarios. Las dos cosas pueden ser ciertas según qué se llame gasto.",
    },
    {
        question: "¿Qué pasa si el Congreso no la aprueba?",
        answer: `El presupuesto de 2027 quedaría desfinanciado. El Gobierno proyecta un déficit de ${num(FISCAL.deficit2027)} % del PIB sin la ley, y tendría que recortar más gasto, endeudarse más caro o volver a intentarlo en 2027. Para el mercado sería una mala señal: más riesgo de rebaja en la calificación, tasas de interés más altas y presión sobre el dólar.`,
    },
];

const site = Astro.site?.href ?? "/";
const path = "/blog/ley-de-rescate-economico";
const title = "Ley de Rescate Económico explicada fácil: IVA, renta y salud (con calculadoras)";
const description =
    "Qué propone la Ley de Rescate de De la Espriella en IVA, renta, salud y gasto, cuánto te cambia el bolsillo y qué podría pasar con la economía. Con calculadoras.";
const ogPath = "/og/ley-de-rescate-economico.png";
const jsonLd = articleJsonLd({
    site,
    path,
    title,
    description,
    crumb: "Ley de Rescate Económico",
    published: RESCATE_PUBLISHED,
    modified: RESCATE_REVIEW,
    image: ogPath,
    keywords: ["Ley de Rescate Económico", "reforma tributaria 2026", "Abelardo de la Espriella", "IVA 19 %", "renta personas naturales", "aportes a salud", "EfectIVA", "RUGE"],
    faqs,
});

const debtMarks = [
    { value: 55, label: "Ancla" },
    { value: 63, label: "Alerta" },
    { value: 71, label: "Límite" },
];
const debtBars = [
    { label: "Junio de 2026", value: FISCAL.debt2026q2 },
    { label: "2027 sin la ley", value: FISCAL.debt2027 },
    { label: "2027 con la ley", value: FISCAL.debtWithLaw },
];
const funding = [
    { who: "Lo que dice el Gobierno", cuts: 70, note: "Cuenta como menor gasto quitar beneficios tributarios." },
    { who: "Citi", cuts: 25, note: "Recortes directos: cerca de una cuarta parte." },
    { who: "La Silla Vacía", cuts: 21, note: "Recortes efectivos: 0,74 % del PIB, unos $16,7 billones." },
];
---

<Layout title={title} description={description} image={ogPath} imageAlt="La Ley de Rescate Económico explicada fácil" imageWidth={1200} imageHeight={630} canvas={false} type="article" jsonLd={jsonLd}>
    <div class="tool-flag" aria-hidden="true"></div>

    <main class="tool post">
        <Topbar
            parent={{ href: "/blog", label: "Blog" }}
            crumb="Ley de Rescate"
            links={[
                { href: "#resumen", label: "Resumen" },
                { href: "#iva", label: "IVA" },
                { href: "#renta", label: "Renta" },
                { href: "#salud", label: "Salud" },
                { href: "#consecuencias", label: "Consecuencias" },
                { href: "#preguntas", label: "Preguntas" },
            ]}
        />

        <header class="hero">
            <p class="kicker">Economía explicada fácil</p>
            <h1>La Ley de Rescate, <span>explicada fácil</span></h1>
            <p class="lead">
                El gobierno de Abelardo de la Espriella le pidió al Congreso <strong>una reforma para tapar el hueco de las cuentas del Estado</strong>:
                sube impuestos, recorta gasto y cambia lo que pagas de salud. Aquí te explico, sin enredos, qué propone, a quién le toca
                pagar y qué podría pasar con la economía. Con calculadoras para que veas tu caso.
            </p>
            <p class="updated">
                Por <a href="/">Antonio Sierra</a> · <time datetime={RESCATE_PUBLISHED}>{longDate(RESCATE_PUBLISHED)}</time> · Lectura de 20 minutos
            </p>
            <div class:list={["status", { law: RESCATE_STATUS.isLaw }]}>
                <span class="status-dot" aria-hidden="true"></span>
                <p><strong>{RESCATE_STATUS.label}.</strong> {RESCATE_STATUS.detail}</p>
            </div>
        </header>

        <section id="resumen" aria-labelledby="resumen-titulo">
            <header class="head">
                <h2 id="resumen-titulo">Si solo tienes un minuto</h2>
                <p>Lo que más se siente en el bolsillo, según el proyecto radicado. Todo puede cambiar en el Congreso.</p>
            </header>
            <ul class="facts">
                <li>
                    <b>5&nbsp;% → 19&nbsp;%</b>
                    <span>IVA del café, el azúcar, el aceite y las pastas desde 2028. Frutas y verduras pasan de 0&nbsp;% a 19&nbsp;%.</span>
                </li>
                <li>
                    <b>9&nbsp;%</b>
                    <span>Tramo nuevo de renta. Un empleado empezaría a pagar con unos {formatCOP(firstNew)} de sueldo, no {formatCOP(firstNow)}.</span>
                </li>
                <li>
                    <b>4&nbsp;% → 5,5&nbsp;%</b>
                    <span>Aporte a salud para quien gana más de 2 mínimos, y sube por escalones hasta 8&nbsp;%. Desde enero de 2027.</span>
                </li>
                <li>
                    <b>+47&nbsp;%</b>
                    <span>Precio estimado de los cigarrillos. La cerveza pasaría de unos $3.500 a cerca de $5.000.</span>
                </li>
                <li>
                    <b>35&nbsp;% → 31&nbsp;%</b>
                    <span>Impuesto de renta de las empresas, en dos años. Las megainversiones podrían pagar 20&nbsp;%.</span>
                </li>
                <li>
                    <b>−20&nbsp;%</b>
                    <span>Gastos de personal del Estado a 2028, y la mitad menos en contratos de prestación de servicios.</span>
                </li>
            </ul>

            <nav class="index" aria-label="Contenido del artículo">
                <p>Lo que vas a encontrar</p>
                <ul>
                    <li><a href="#por-que">Por qué el Gobierno dice que hay que rescatar las cuentas</a></li>
                    <li><a href="#de-donde">De dónde saldría la plata</a></li>
                    <li><a href="#iva">IVA: qué productos suben y cuánto te cuesta</a></li>
                    <li><a href="#renta">Renta: el tramo nuevo del 9&nbsp;%</a></li>
                    <li><a href="#salud">Salud: lo que te descuentan y lo que le cuestas a tu empresa</a></li>
                    <li><a href="#vicios">Cerveza, licores y cigarrillos</a></li>
                    <li><a href="#empresas">Empresas, grandes inversiones y deudas con la DIAN</a></li>
                    <li><a href="#recortes">El recorte del Estado y la nueva regla fiscal</a></li>
                    <li><a href="#consecuencias">Qué podría pasar con la economía</a></li>
                    <li><a href="#glosario">Glosario sin tecnicismos</a></li>
                </ul>
            </nav>
        </section>

        <section id="por-que" aria-labelledby="por-que-titulo">
            <header class="head">
                <h2 id="por-que-titulo">¿Por qué un “rescate”?</h2>
                <p>Porque el Estado gasta mucho más de lo que le entra, y el hueco crece.</p>
            </header>

            <div class="split">
                <div class="prose">
                    <aside class="analogy">
                        <p class="analogy-head">Piénsalo como una casa</p>
                        <p>
                            Una familia gana un sueldo, pero cada mes paga más de lo que entra: mercado, arriendo, colegio y las cuotas de
                            las tarjetas. La diferencia la cubre con más tarjetas. Al principio funciona; después, buena parte del sueldo se va
                            en intereses y los bancos le prestan más caro. Para salir tiene dos caminos, y casi siempre usa los dos:
                            <strong>ganar más o gastar menos</strong>.
                        </p>
                    </aside>
                    <p>
                        Con el Estado pasa lo mismo. A lo que le falta cada año se le llama <dfn>déficit</dfn> y a lo que acumula, <dfn>deuda</dfn>.
                        El nuevo gobierno revisó las cuentas en agosto y encontró que el déficit de 2027 llegaría al
                        <strong>{num(FISCAL.deficit2027)}&nbsp;% del PIB</strong> si no se hace nada. En palabras sencillas: por cada $100 que produce
                        el país en un año, el Gobierno gastaría {cents(FISCAL.deficit2027)} más de
                        lo que recauda.
                    </p>
                    <p>
                        En pesos son unos <strong>${formatNumber(deficitPesos)} billones</strong> en un solo año, cerca de
                        <strong>{formatCOP(Math.round(perPerson / 100_000) * 100_000)} por cada colombiano</strong>. El presupuesto de 2027 es de
                        ${FISCAL.budget2027} billones, el más grande frente al tamaño de la economía desde la pandemia.
                    </p>
                    <p>
                        La deuda neta ya estaba en {num(FISCAL.debt2026q2)}&nbsp;% del PIB a mitad de 2026, por encima del {debtMarks[0].value}&nbsp;% que la
                        ley considera sano. Cuando un país debe mucho, quienes le prestan cobran más intereses, las calificadoras le bajan la nota
                        y ese costo termina llegando a los créditos de todos.
                    </p>
                    <p>
                        El proyecto se llama <strong>Ley de Rescate Económico</strong> (Proyecto de Ley 477 de 2026). Lo radicaron el vicepresidente
                        José Manuel Restrepo y el ministro de Hacienda, Miguel Gómez Martínez, el 29 de octubre. Tiene 106 artículos y busca un
                        ajuste de {num(FISCAL.adjustment2027)}&nbsp;% del PIB en 2027, unos ${FISCAL.adjustmentPesos} billones, que crecería a
                        {num(FISCAL.adjustment2028, 2)}&nbsp;% en 2028 y {num(FISCAL.adjustment2030, 2)}&nbsp;% en 2030.
                    </p>
                </div>

                <div class="charts">
                    <figure class="chart">
                        <figcaption>
                            <b>Déficit del Gobierno</b>
                            <span>Por cada $100 que produce el país</span>
                        </figcaption>
                        <ul class="bars">
                            {
                                [
                                    { label: "2026", value: FISCAL.deficit2026 },
                                    { label: "2027 sin la ley", value: FISCAL.deficit2027, hot: true },
                                    { label: "2027 con la ley", value: FISCAL.deficitWithLaw, good: true },
                                ].map(({ label, value, hot, good }) => (
                                    <li class:list={{ hot, good }} style={`--v: ${value / 10}`}>
                                        <span>{label}</span>
                                        <span class="bar" aria-hidden="true"></span>
                                        <b>{cents(value)}</b>
                                    </li>
                                ))
                            }
                        </ul>
                        <p class="chart-note">Proyecciones del Ministerio de Hacienda. El “con la ley” es su estimación preliminar.</p>
                    </figure>

                    <figure class="chart">
                        <figcaption>
                            <b>Deuda neta del Gobierno</b>
                            <span>Como porcentaje del PIB, frente a la regla fiscal</span>
                        </figcaption>
                        <div class="gauge">
                            {
                                debtBars.map(({ label, value }) => (
                                    <div class="gauge-row" style={`--v: ${(value - 40) / 40}`}>
                                        <span>{label}</span>
                                        <span class="gauge-track" aria-hidden="true">
                                            <span class="gauge-fill"></span>
                                            {debtMarks.map(({ value: mark }) => (
                                                <i style={`--m: ${(mark - 40) / 40}`}></i>
                                            ))}
                                        </span>
                                        <b>{num(value)}&nbsp;%</b>
                                    </div>
                                ))
                            }
                            <div class="gauge-legend">
                                {debtMarks.map(({ value, label }) => <span>{label} {value}&nbsp;%</span>)}
                            </div>
                        </div>
                        <p class="chart-note">La escala arranca en 40&nbsp;%. Deuda de junio: Citi. 2027: Ministerio de Hacienda.</p>
                    </figure>
                </div>
            </div>
        </section>

        <section id="de-donde" aria-labelledby="de-donde-titulo">
            <header class="head">
                <h2 id="de-donde-titulo">¿De dónde saldría la plata?</h2>
                <p>Aquí está la gran discusión: ¿es un recorte del Estado o una reforma tributaria?</p>
            </header>
            <div class="split">
                <div class="prose">
                    <p>
                        El ministro Gómez dice que entre $30 y $35 billones del ajuste salen de austeridad, y el Gobierno repite que
                        <strong>siete de cada diez pesos</strong> vienen del gasto. Pero varios análisis llegan a otra cuenta.
                    </p>
                    <p>
                        La diferencia está en qué se llama “gasto”. Cuando el Estado deja de cobrarle IVA a un producto, renuncia a una plata:
                        a eso se le dice <dfn>gasto tributario</dfn>. El Gobierno cuenta quitar esas exenciones como un recorte. Quien paga el café
                        con IVA del 19&nbsp;%, en cambio, lo siente como un impuesto nuevo.
                    </p>
                    <p>
                        Con la cuenta de La Silla Vacía, los recortes efectivos son 0,74&nbsp;% del PIB en 2028, unos $16,7 billones: el 21&nbsp;% del efecto
                        de la ley. Citi llega a una conclusión parecida, cerca de una cuarta parte.
                    </p>
                    <p>
                        Ninguna de las dos cuentas está “mal”: miden cosas distintas. Lo útil para ti es saber que
                        <strong>la mayor parte del ajuste se sentiría en lo que pagas</strong>, más que en lo que deja de gastar el Estado.
                    </p>
                </div>
                <figure class="chart">
                    <figcaption>
                        <b>¿Quién pone la plata?</b>
                        <span>Parte del ajuste que sale de recortes y parte que sale de impuestos y aportes</span>
                    </figcaption>
                    <ul class="stack">
                        {
                            funding.map(({ who, cuts, note }) => (
                                <li>
                                    <p>{who}</p>
                                    <span class="stack-bar" style={`--c: ${cuts}`}>
                                        <span class="stack-cuts">{cuts}&nbsp;%</span>
                                        <span class="stack-tax">{100 - cuts}&nbsp;%</span>
                                    </span>
                                    <small>{note}</small>
                                </li>
                            ))
                        }
                    </ul>
                    <p class="legend">
                        <span><i class="swatch cuts"></i>Recorte del gasto</span>
                        <span><i class="swatch tax"></i>Impuestos y aportes</span>
                    </p>
                </figure>
            </div>
        </section>

        <section id="iva" aria-labelledby="iva-titulo">
            <header class="head">
                <h2 id="iva-titulo">IVA: lo que más se siente en el mercado</h2>
                <p>Es la medida que más recauda: unos $25 billones al año, según La Silla Vacía.</p>
            </header>

            <div class="split">
                <div class="prose">
                    <p>
                        El <dfn>IVA</dfn> es el impuesto que va escondido en el precio de casi todo lo que compras. Hoy hay tres tarifas: 19&nbsp;% para
                        la mayoría de cosas, 5&nbsp;% para algunos alimentos y servicios, y 0&nbsp;% para lo más básico. El proyecto
                        <strong>casi elimina la tarifa del 5&nbsp;%</strong> y saca muchos productos de la lista de los que no pagan.
                    </p>
                    <p>
                        Cuando algo pasa de 5&nbsp;% a 19&nbsp;%, el precio no sube 14&nbsp;%, sube un poco menos: <strong>13,3&nbsp;%</strong>. Lo que hoy cuesta
                        $10.500 con IVA (10.000 + 5&nbsp;%) pasaría a $11.900 (10.000 + 19&nbsp;%). Si pasa de 0&nbsp;% a 19&nbsp;%, sube el 19&nbsp;% completo.
                    </p>
                    <p>
                        Para que no golpee a los hogares más pobres, el proyecto crea <dfn>EfectIVA</dfn>: desde 2028 devolvería el 100&nbsp;% del IVA a
                        las personas en pobreza (unos 19 millones) y entre el 30&nbsp;% y el 50&nbsp;% a la población vulnerable (otros 16,5 millones), con un
                        tope de {num(EFECTIVA_CAP_UVT)} UVT por persona al mes ({uvtPesos(EFECTIVA_CAP_UVT)} en pesos de 2026). Costaría unos
                        $20 billones al año.
                    </p>
                </div>
                <div class="lists">
                    <div class="list up">
                        <h3>Pasan a 19&nbsp;%</h3>
                        <ul>
                            <li><b>Café, chocolate, azúcar, aceites y pastas</b> <span>5&nbsp;% → 19&nbsp;% · 2028</span></li>
                            <li><b>Frutas, verduras y hortalizas</b> <span>0&nbsp;% → 19&nbsp;% · 2028</span></li>
                            <li><b>Queso fresco, camarón de cultivo y ganado</b> <span>0&nbsp;% → 19&nbsp;% · 2028</span></li>
                            <li><b>Medicina prepagada</b> <span>5&nbsp;% → 19&nbsp;% · 2028</span></li>
                            <li><b>Licores y vinos</b> <span>5&nbsp;% → 19&nbsp;% · al aprobarse</span></li>
                            <li><b>Compras internacionales de menos de US$200</b> <span>0&nbsp;% → 19&nbsp;% · al aprobarse</span></li>
                            <li><b>Apuestas en línea</b> <span>0&nbsp;% → 19&nbsp;% · al aprobarse</span></li>
                            <li><b>Carros eléctricos</b> <span>5&nbsp;% → 19&nbsp;% · al aprobarse</span></li>
                        </ul>
                    </div>
                    <div class="list keep">
                        <h3>Siguen sin IVA</h3>
                        <p>Carne, pollo, pescado, leche, huevos, arroz, papa, yuca, pan, arepa, panela, agua, gas y luz.</p>
                        <p class="list-note">Y salchichón, butifarra y mortadela bajarían de 5&nbsp;% a 0&nbsp;% en 2028.</p>
                    </div>
                </div>
            </div>

            <div class="workbench" data-calc="iva">
                <form class="form" data-form>
                    <div class="calc-head">
                        <h3>Calcula tu mercado con la reforma</h3>
                        <p class="hint">Escribe cuánto gastas hoy al mes en cada grupo. Ponle $0 a lo que no compras.</p>
                    </div>
                    <div class="grid-2">
                        {
                            IVA_GROUPS.map((group) => (
                                <div class="field">
                                    <label for={`iva-${group.id}`}>{group.label}</label>
                                    <div class="money">
                                        <span aria-hidden="true">$</span>
                                        <input
                                            id={`iva-${group.id}`}
                                            name={group.id}
                                            type="text"
                                            inputmode="numeric"
                                            autocomplete="off"
                                            value={group.sample ? formatNumber(group.sample) : ""}
                                            placeholder="0"
                                            data-from={group.from}
                                            data-to={group.to}
                                        />
                                    </div>
                                    <p class="hint">
                                        {group.examples} · <span class="when">{group.when}</span>
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                    <div class="row">
                        <div class="field">
                            <label for="iva-personas">Personas en tu hogar</label>
                            <select class="input" id="iva-personas" name="personas">
                                {[1, 2, 3, 4, 5, 6].map((value) => <option value={value} selected={value === 3}>{value}</option>)}
                            </select>
                        </div>
                        <div class="field">
                            <label for="iva-efectiva">¿Recibirías EfectIVA?</label>
                            <select class="input" id="iva-efectiva" name="efectiva">
                                <option value="0">No, no lo recibiría</option>
                                <option value="0.3">Sí, devolución del 30&nbsp;%</option>
                                <option value="0.4">Sí, devolución del 40&nbsp;%</option>
                                <option value="0.5">Sí, devolución del 50&nbsp;%</option>
                                <option value="1">Sí, estoy en pobreza (100&nbsp;%)</option>
                            </select>
                        </div>
                    </div>
                </form>
                <div class="result">
                    <div class="ticket">
                        <p class="ticket-head">Tu mercado del mes</p>
                        <dl class="ticket-lines">
                            <div><dt>Hoy pagas</dt><dd data-out="today">{formatCOP(ivaToday)}</dd></div>
                            <div><dt>Con la reforma</dt><dd data-out="after">{formatCOP(Math.round(ivaAfter))}</dd></div>
                            <div data-refund-row hidden><dt>EfectIVA te devolvería</dt><dd data-out="refund">$0</dd></div>
                        </dl>
                        <div class="ticket-big">
                            <span data-out="label">Pagarías de más al mes</span>
                            <b data-out="extra">{formatCOP(Math.round(ivaAfter - ivaToday))}</b>
                        </div>
                        <p class="ticket-foot">Al año: <b data-out="year">{formatCOP(Math.round((ivaAfter - ivaToday) * 12))}</b></p>
                    </div>
                    <p class="hint result-note">
                        Supone que los comercios trasladan todo el IVA al precio. La devolución real de EfectIVA se calcularía sobre todo el IVA
                        que pagas, no solo sobre estos productos.
                    </p>
                    <p class="sr-only" aria-live="polite" data-live></p>
                </div>
            </div>
        </section>

        <section id="renta" aria-labelledby="renta-titulo">
            <header class="head">
                <h2 id="renta-titulo">Renta: aparece un tramo del 9&nbsp;%</h2>
                <p>Más personas de clase media empezarían a pagar impuesto de renta.</p>
            </header>
            <div class="split">
                <div class="prose">
                    <p>
                        El impuesto de renta se cobra por <dfn>tramos</dfn>, como los pisos de un edificio: cada peso paga la tarifa del piso en
                        el que cae. Hoy, los primeros 1.090 <dfn>UVT</dfn> de renta líquida al año no pagan nada. Con el proyecto, ese primer piso
                        libre baja a <strong>720&nbsp;UVT</strong> ({uvtPesos(720)} al año, unos {uvtPesos(60)} al mes en pesos de 2026) y entre 720 y
                        1.090&nbsp;UVT se paga 9&nbsp;%.
                    </p>
                    <p>
                        Ojo: <strong>renta líquida no es tu sueldo</strong>. Es lo que queda después de restar lo que te descuentan de salud y
                        pensión y las rentas exentas, como el 25&nbsp;% del salario. Por eso alguien con un sueldo de unos {formatCOP(firstNew)} al mes
                        llegaría justo a ese piso.
                    </p>
                    <p>Además, el proyecto aprieta los alivios que hoy bajan la base:</p>
                    <ul>
                        <li>La renta exenta del 25&nbsp;% del salario tendría un tope de 630&nbsp;UVT al año, no 790.</li>
                        <li>El tope total de exenciones y deducciones bajaría de 1.340 a 1.180&nbsp;UVT al año.</li>
                        <li>Desaparece la deducción de 72&nbsp;UVT por cada dependiente, de hasta cuatro personas.</li>
                        <li>Los premios de lotería pagarían 30&nbsp;% de ganancia ocasional, no 20&nbsp;%.</li>
                        <li>Arriba, todo lo que pase de 8.670&nbsp;UVT pagaría 39&nbsp;%, que hoy solo aplica desde 31.000&nbsp;UVT.</li>
                    </ul>
                    <p>
                        La retención en la fuente de cada mes también tendría un tramo del 9&nbsp;%, así que el cambio se notaría en la nómina, no solo
                        al declarar. Si se aprueba en 2026, la tabla aplicaría a lo que ganes en 2027.
                    </p>
                </div>
                <div class="table-wrap">
                    <table class="amounts compare-table">
                        <caption>Tabla de renta de personas naturales (art. 241). Renta líquida al año, en UVT.</caption>
                        <thead>
                            <tr>
                                <th scope="col">Hoy</th>
                                <th scope="col" class="num">Tarifa</th>
                            </tr>
                        </thead>
                        <tbody>
                            {
                                tableRows(TABLE_241_NOW).map(({ range, rate }) => (
                                    <tr>
                                        <th scope="row">{range}</th>
                                        <td class="num">{rate}</td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                    <table class="amounts compare-table">
                        <thead>
                            <tr>
                                <th scope="col">Con el proyecto</th>
                                <th scope="col" class="num">Tarifa</th>
                            </tr>
                        </thead>
                        <tbody>
                            {
                                tableRows(TABLE_241_NEW).map(({ range, rate }, index) => (
                                    <tr class:list={{ fresh: index === 1 }}>
                                        <th scope="row">
                                            {range}
                                            {index === 1 && <span class="tag">Nuevo</span>}
                                        </th>
                                        <td class="num strong">{rate}</td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                    <p class="hint">Tarifa marginal: se cobra solo sobre lo que cae dentro de cada tramo.</p>
                </div>
            </div>

            <div class="workbench" data-calc="renta">
                <form class="form" data-form>
                    <div class="calc-head">
                        <h3>¿Cuánta renta pagarías?</h3>
                        <p class="hint">Para empleados con salario fijo, sin otros ingresos ni deducciones. En pesos de 2026.</p>
                    </div>
                    <div class="field">
                        <label for="renta-salario">Tu salario mensual</label>
                        <div class="money big">
                            <span aria-hidden="true">$</span>
                            <input id="renta-salario" name="salario" type="text" inputmode="numeric" autocomplete="off" value={formatNumber(RENTA_SAMPLE)} />
                        </div>
                        <div class="chips" role="group" aria-label="Salarios de ejemplo">
                            {[3_500_000, 4_650_000, 6_000_000, 10_000_000, 20_000_000].map((value) => (
                                <button type="button" class="chip" data-amount={value}>{formatCOP(value)}</button>
                            ))}
                        </div>
                    </div>
                    <div class="field">
                        <label for="renta-dependientes">Personas que dependen de ti</label>
                        <select class="input" id="renta-dependientes" name="dependientes">
                            {[0, 1, 2, 3, 4].map((value) => <option value={value}>{value === 0 ? "Ninguna" : value}</option>)}
                        </select>
                        <p class="hint">Hoy cada una te resta 72&nbsp;UVT al año. El proyecto elimina esa deducción.</p>
                    </div>
                    <details class="breakdown">
                        <summary>Ver la cuenta completa</summary>
                        <table class="amounts">
                            <thead>
                                <tr><th scope="col">Al año</th><th scope="col" class="num">Hoy</th><th scope="col" class="num">Proyecto</th></tr>
                            </thead>
                            <tbody>
                                {
                                    [
                                        ["income", "Salario"],
                                        ["health", "− Salud"],
                                        ["pension", "− Pensión"],
                                        ["solidarity", "− Fondo de solidaridad"],
                                        ["exempt", "− Renta exenta (25&nbsp;%)"],
                                        ["dependents", "− Dependientes"],
                                    ].map(([key, label]) => (
                                        <tr>
                                            <th scope="row">{label}</th>
                                            <td class="num" data-now={key}>{formatCOP(Math.round(rentaNow[key as keyof typeof rentaNow] as number))}</td>
                                            <td class="num" data-new={key}>{formatCOP(Math.round(rentaNew[key as keyof typeof rentaNew] as number))}</td>
                                        </tr>
                                    ))
                                }
                                <tr>
                                    <th scope="row">Renta líquida en UVT</th>
                                    <td class="num strong" data-now="uvt">{num(rentaNow.taxableUvt)}</td>
                                    <td class="num strong" data-new="uvt">{num(rentaNew.taxableUvt)}</td>
                                </tr>
                            </tbody>
                        </table>
                    </details>
                </form>
                <div class="result">
                    <div class="ticket">
                        <p class="ticket-head">Impuesto de renta al año</p>
                        <div class="versus">
                            <div>
                                <span>Hoy</span>
                                <b data-out="now">{formatCOP(rentaNow.tax)}</b>
                                <small data-out="now-bracket">Tramo de {pct(rentaNow.bracket.rate)}</small>
                            </div>
                            <div>
                                <span>Con el proyecto</span>
                                <b data-out="new">{formatCOP(rentaNew.tax)}</b>
                                <small data-out="new-bracket">Tramo de {pct(rentaNew.bracket.rate)}</small>
                            </div>
                        </div>
                        <div class="ticket-big">
                            <span data-out="label">Pagarías de más al año</span>
                            <b data-out="diff">{formatCOP(rentaNew.tax - rentaNow.tax)}</b>
                        </div>
                        <p class="ticket-foot">Equivale a <b data-out="month">{formatCOP(Math.round((rentaNew.tax - rentaNow.tax) / 12))}</b> al mes</p>
                    </div>
                    <p class="hint result-note">
                        Usa la UVT de 2026 ({formatCOP(UVT_2026)}) en los dos lados para comparar contra hoy. Si tienes otros ingresos, intereses
                        de vivienda o aportes voluntarios, tu resultado cambia.
                    </p>
                    <p class="sr-only" aria-live="polite" data-live></p>
                </div>
            </div>
        </section>

        <section id="salud" aria-labelledby="salud-titulo">
            <header class="head">
                <h2 id="salud-titulo">Salud: más descuento en la nómina</h2>
                <p>El sistema de salud recauda $29 billones y gasta más de $40 billones, según el Ministerio de Hacienda.</p>
            </header>
            <div class="split">
                <div class="prose">
                    <p>
                        Hoy todos los empleados aportan el <strong>4&nbsp;%</strong> de su salario a salud, y los independientes el 12,5&nbsp;%. Desde el
                        1 de enero de 2027, quien gane más de 2 salarios mínimos aportaría más, por escalones: a más sueldo, más porcentaje.
                    </p>
                    <p>
                        La otra mitad del cambio la siente tu empresa. Hoy las sociedades no pagan salud (8,5&nbsp;%), SENA (2&nbsp;%) ni ICBF (3&nbsp;%) por los
                        trabajadores que ganan menos de 10 mínimos: se llama <dfn>exoneración de parafiscales</dfn>. Con el proyecto, ese alivio
                        quedaría solo para quien gana hasta 2 mínimos. Entre 2 y 3 mínimos la empresa pagaría 6&nbsp;%, y desde 3 mínimos el 13,5&nbsp;%
                        completo.
                    </p>
                    <p>
                        ¿Por qué importa si lo paga la empresa? Porque contratarte formalmente se vuelve más caro, y eso puede frenar aumentos o
                        nuevas contrataciones de salarios medios. Volvemos a esto en <a href="#consecuencias">las consecuencias</a>.
                    </p>
                </div>
                <div class="table-wrap">
                    <table class="amounts">
                        <caption>Aporte a salud desde enero de 2027, según lo que ganas</caption>
                        <thead>
                            <tr>
                                <th scope="col">Salarios mínimos</th>
                                <th scope="col" class="num">Empleado</th>
                                <th scope="col" class="num">Independiente</th>
                            </tr>
                        </thead>
                        <tbody>
                            {
                                HEALTH_ROWS.map(({ from, upTo, employee, independent }) => (
                                    <tr>
                                        <th scope="row">{from === 0 ? `Hasta ${upTo}` : upTo === Infinity ? `Más de ${from}` : `${from} a ${upTo}`}</th>
                                        <td class="num strong">{pct(employee)}</td>
                                        <td class="num">{pct(independent)}</td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                    <p class="hint">Hoy: 4&nbsp;% empleados y 12,5&nbsp;% independientes. Salario mínimo de 2026: {formatCOP(WAGE_2026.salary)}.</p>
                </div>
            </div>

            <div class="workbench" data-calc="salud">
                <form class="form" data-form>
                    <div class="calc-head">
                        <h3>¿Cuánto te descontarían de salud?</h3>
                        <p class="hint">Con el salario mínimo de 2026. El de 2027 cambia un poco los cortes.</p>
                    </div>
                    <div class="field">
                        <label for="salud-salario" data-out="salary-label">Tu salario mensual</label>
                        <div class="money big">
                            <span aria-hidden="true">$</span>
                            <input id="salud-salario" name="salario" type="text" inputmode="numeric" autocomplete="off" value={formatNumber(HEALTH_SAMPLE)} />
                        </div>
                        <div class="chips" role="group" aria-label="Salarios de ejemplo">
                            {[3_000_000, 4_500_000, 6_000_000, 10_000_000, 18_000_000].map((value) => (
                                <button type="button" class="chip" data-amount={value}>{formatCOP(value)}</button>
                            ))}
                        </div>
                        <p class="hint" data-independent-hint hidden>Como independiente cotizas sobre el 40&nbsp;% de lo que facturas: ese es tu ingreso base.</p>
                    </div>
                    <label class="switch">
                        <input type="checkbox" name="independiente" />
                        <span class="track" aria-hidden="true"></span>
                        <span>Soy independiente</span>
                    </label>
                </form>
                <div class="result">
                    <div class="ticket">
                        <p class="ticket-head">Aporte a salud del mes</p>
                        <dl class="ticket-lines">
                            <div><dt>Hoy</dt><dd data-out="now">{formatCOP(healthNow(HEALTH_SAMPLE))}</dd></div>
                            <div><dt data-out="new-label">Con el proyecto ({pct(healthNew(HEALTH_SAMPLE).rate)})</dt><dd data-out="new">{formatCOP(healthNew(HEALTH_SAMPLE).value)}</dd></div>
                        </dl>
                        <div class="ticket-big">
                            <span>Te llegaría menos al mes</span>
                            <b data-out="diff">{formatCOP(healthNew(HEALTH_SAMPLE).value - healthNow(HEALTH_SAMPLE))}</b>
                        </div>
                        <p class="ticket-foot">Al año: <b data-out="year">{formatCOP((healthNew(HEALTH_SAMPLE).value - healthNow(HEALTH_SAMPLE)) * 12)}</b></p>
                        <div class="employer" data-employer>
                            <p>A tu empresa le costarías más</p>
                            <b data-out="employer">+{formatCOP(HEALTH_SAMPLE * 0.135)}</b>
                            <small data-out="employer-note">Al mes, en salud, SENA e ICBF (13,5&nbsp;%)</small>
                        </div>
                    </div>
                    <p class="hint result-note">
                        Lo de la empresa aplica a sociedades que hoy usan la exoneración. Si ganas 10 mínimos o más, la empresa ya los paga y no
                        cambia.
                    </p>
                    <p class="sr-only" aria-live="polite" data-live></p>
                </div>
            </div>
        </section>

        <section id="vicios" aria-labelledby="vicios-titulo">
            <header class="head">
                <h2 id="vicios-titulo">Cerveza, licores y cigarrillos</h2>
                <p>Los llamados impuestos a los vicios: suben bastante y desde 2027.</p>
            </header>
            <div class="split">
                <div class="prose">
                    <p>
                        Además del IVA, estos productos pagan un <dfn>impuesto al consumo</dfn> fijo por unidad. El proyecto lo cambia para que
                        dependa de los grados de alcohol y del precio, y lo sube cada año con la inflación más 4 puntos desde 2028.
                    </p>
                    <ul>
                        <li><strong>Cerveza:</strong> $330 por grado de alcohol cada 330 ml, más 10&nbsp;% del precio.</li>
                        <li><strong>Licores:</strong> $750 por grado cada 750 ml, más 35&nbsp;% del precio, además del IVA que pasa de 5&nbsp;% a 19&nbsp;%.</li>
                        <li><strong>Cigarrillos:</strong> $7.823 por cajetilla en 2027 y $11.200 en 2028, más 10&nbsp;% del precio.</li>
                        <li><strong>Vapeadores:</strong> $1.000 por mililitro en 2027 y $2.000 en 2028, más 30&nbsp;% del precio.</li>
                        <li><strong>Bebidas ultraprocesadas:</strong> desde 2028, $45 cada 100 ml si tienen menos de 9 g de azúcar y $76 si tienen más.</li>
                    </ul>
                    <p>
                        Las estimaciones de precio que citan los análisis: cigarrillos <strong>+47&nbsp;%</strong>, vapeadores <strong>+53&nbsp;%</strong>,
                        bebidas alcohólicas <strong>+32,6&nbsp;%</strong> en promedio, y una cerveza que pasaría de unos $3.500 a cerca de $5.000. Solo
                        el impuesto a la cerveza recaudaría unos $7,1 billones al año.
                    </p>
                </div>

                <div class="workbench mini" data-calc="vicios">
                    <form class="form" data-form>
                        <div class="calc-head">
                            <h3>¿Cuánto más pagarías?</h3>
                        </div>
                        <fieldset class="field">
                            <legend>Producto</legend>
                            <div class="options" style="--cols: 2">
                                {
                                    VICES.map((item, index) => (
                                        <label class="option">
                                            <input type="radio" name="producto" value={item.id} checked={index === 0} data-price={item.price} data-quantity={item.quantity} data-rise={item.rise} data-unit={item.unit} />
                                            <span>
                                                <strong>{item.label}</strong>
                                                <small>+{pct(item.rise)} estimado</small>
                                            </span>
                                        </label>
                                    ))
                                }
                            </div>
                        </fieldset>
                        <div class="row">
                            <div class="field">
                                <label for="vicio-precio">Precio hoy</label>
                                <div class="money">
                                    <span aria-hidden="true">$</span>
                                    <input id="vicio-precio" name="precio" type="text" inputmode="numeric" autocomplete="off" value={formatNumber(vice.price)} />
                                </div>
                            </div>
                            <div class="field">
                                <label for="vicio-cantidad" data-out="unit-label">Cervezas al mes</label>
                                <input class="input" id="vicio-cantidad" name="cantidad" type="number" min="0" step="1" value={vice.quantity} />
                            </div>
                        </div>
                    </form>
                    <div class="ticket">
                        <dl class="ticket-lines">
                            <div><dt>Precio estimado</dt><dd data-out="price">{formatCOP(Math.round(vice.price * (1 + vice.rise)))}</dd></div>
                        </dl>
                        <div class="ticket-big">
                            <span>Gastarías de más al mes</span>
                            <b data-out="extra">{formatCOP(Math.round(vice.price * vice.rise * vice.quantity))}</b>
                        </div>
                        <p class="ticket-foot">Al año: <b data-out="year">{formatCOP(Math.round(vice.price * vice.rise * vice.quantity * 12))}</b></p>
                    </div>
                    <p class="sr-only" aria-live="polite" data-live></p>
                </div>
            </div>
        </section>

        <section id="empresas" aria-labelledby="empresas-titulo">
            <header class="head">
                <h2 id="empresas-titulo">Empresas, grandes inversiones y deudas con la DIAN</h2>
                <p>Aquí el proyecto va en la dirección contraria: baja impuestos para atraer inversión.</p>
            </header>
            <div class="rules six">
                <article>
                    <h3>Renta de empresas: de 35&nbsp;% a 31&nbsp;%</h3>
                    <p>
                        La tarifa general bajaría a 33&nbsp;% en 2027 y a 31&nbsp;% desde 2028. La idea: que a las empresas les quede más plata para
                        invertir y contratar, y que Colombia compita con países que cobran menos.
                    </p>
                </article>
                <article>
                    <h3>Los bancos pagan un extra</h3>
                    <p>
                        Las entidades financieras grandes seguirían con una sobretasa de 5 puntos: 38&nbsp;% en 2027 y 36&nbsp;% entre 2028 y 2030. Hoy
                        pagan 40&nbsp;%.
                    </p>
                </article>
                <article>
                    <h3>RUGE: estabilidad por 16 años</h3>
                    <p>
                        Un régimen para megainversiones: renta de 20&nbsp;% para las que arranquen en 2027 o 2028 (26&nbsp;% desde 2029), dividendos al
                        exterior de 8&nbsp;% y reglas congeladas por 16 años. Pide invertir desde unos $135.000 millones en agro hasta $426.000 millones
                        en infraestructura y energía, y comprar al menos 30&nbsp;% en el país.
                    </p>
                </article>
                <article>
                    <h3>Patrimonio: menos personas, hasta 2030</h3>
                    <p>
                        El impuesto al patrimonio empezaría en 95.500&nbsp;UVT, no en 72.000, con tarifa máxima de 1&nbsp;%, no 1,5&nbsp;%. Y ya no sería
                        permanente: solo de 2027 a 2030.
                    </p>
                </article>
                <article>
                    <h3>Ponerse al día con lo escondido</h3>
                    <p>
                        Hasta el 30 de junio de 2027, quien tenga bienes sin declarar podría legalizarlos ante la DIAN pagando 15&nbsp;%. Para las
                        criptomonedas, 5&nbsp;% sobre su valor al 1 de enero de 2027.
                    </p>
                </article>
                <article>
                    <h3>Descuentos para deudores de la DIAN</h3>
                    <p>
                        También hasta junio de 2027: quien pague lo que debe tendría las sanciones al 40&nbsp;% e intereses del 5&nbsp;% anual, o acuerdos
                        de pago de hasta 12 meses. A cambio, las multas por no facturar subirían fuerte.
                    </p>
                </article>
            </div>
            <p class="prose aside-note">
                Otros cambios: el impuesto al carbono sube año a año hasta 2029, se elimina el impuesto a los plásticos de un solo uso y bajan los
                montos desde los que esconder bienes o no declarar es delito.
            </p>
        </section>

        <section id="recortes" aria-labelledby="recortes-titulo">
            <header class="head">
                <h2 id="recortes-titulo">El recorte del Estado y la nueva regla fiscal</h2>
                <p>La parte de “gastar menos”, y un candado para que el hueco no vuelva a abrirse.</p>
            </header>
            <div class="split">
                <div class="prose">
                    <p>El proyecto obliga al Gobierno a apretarse el cinturón:</p>
                    <ul>
                        <li><strong>Gastos de personal:</strong> 20&nbsp;% menos a 2028, unos $9,6 billones.</li>
                        <li><strong>Contratos de prestación de servicios:</strong> la mitad en 2027 frente a 2026.</li>
                        <li><strong>Facultades extraordinarias:</strong> seis meses para que el presidente fusione o elimine ministerios y entidades, con la meta de reducir el Estado un 15&nbsp;%.</li>
                        <li><strong>Revisión</strong> de más de 250 transferencias y 50 fondos públicos.</li>
                    </ul>
                    <p>
                        La <dfn>regla fiscal</dfn> es como un tope en la tarjeta de crédito del Estado: una ley que le dice cuánto puede deberse.
                        Hoy la meta es una deuda de 55&nbsp;% del PIB y el límite, 71&nbsp;%. El proyecto agrega una <strong>alerta en 63&nbsp;%</strong>: si la
                        deuda la pasa, se activan recortes automáticos, como que los gastos de personal solo puedan crecer la inflación más medio
                        punto.
                    </p>
                    <p>
                        También amplía a siete miembros el comité independiente que vigila las cuentas (el Carf) y obliga a cada nuevo presidente
                        a fijar sus metas antes del 15 de diciembre de su primer año.
                    </p>
                </div>
                <aside class="analogy">
                    <p class="analogy-head">Lo que dicen los que saben</p>
                    <p>
                        <strong>Citi:</strong> la ley estabilizaría la deuda cerca de 64&nbsp;% del PIB en 2030, pero no la bajaría. Sigue por encima de
                        la nueva alerta.
                    </p>
                    <p>
