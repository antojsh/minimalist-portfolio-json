<script>
    import { IVA_GROUPS, EFECTIVA_CAP_UVT, UVT_2026, employerNew, employerNow, healthNew, healthNow, newPrice, rentaFor } from "@/lib/ley-rescate";
    import { formatCOP, formatNumber, parseCOP } from "@/lib/uvt";

    const pct = (value: number) => `${(value * 100).toLocaleString("es-CO", { maximumFractionDigits: 1 })} %`;

    /** Conecta una calculadora: formatea los campos de dinero y recalcula en cada cambio */
    function wire(name: string, update: (form: HTMLFormElement, out: (key: string) => HTMLElement, root: HTMLElement) => string) {
        const root = document.querySelector<HTMLElement>(`[data-calc="${name}"]`);
        if (!root) return;
        const form = root.querySelector<HTMLFormElement>("[data-form]")!;
        const live = root.querySelector<HTMLElement>("[data-live]")!;
        const out = (key: string) => root.querySelector<HTMLElement>(`[data-out="${key}"]`)!;
        const run = () => {
            live.textContent = update(form, out, root);
        };
        for (const input of form.querySelectorAll<HTMLInputElement>('input[inputmode="numeric"]')) {
            input.addEventListener("input", () => {
                const value = parseCOP(input.value);
                input.value = value ? formatNumber(value) : "";
            });
        }
        for (const chip of root.querySelectorAll<HTMLButtonElement>("[data-amount]")) {
            chip.addEventListener("click", () => {
                const input = chip.closest(".field")!.querySelector<HTMLInputElement>("input")!;
                input.value = formatNumber(Number(chip.dataset.amount));
                run();
            });
        }
        form.addEventListener("input", run);
        form.addEventListener("change", run);
        run();
    }

    const money = (form: HTMLFormElement, name: string) => parseCOP((form.elements.namedItem(name) as HTMLInputElement).value);

    wire("iva", (form, out, root) => {
        let today = 0;
        let after = 0;
        let iva = 0;
        for (const group of IVA_GROUPS) {
            const spent = money(form, group.id);
            const price = newPrice(spent, group.from, group.to);
            today += spent;
            after += price;
            iva += (price * group.to) / (1 + group.to);
        }
        const people = Number((form.elements.namedItem("personas") as HTMLSelectElement).value);
        const share = Number((form.elements.namedItem("efectiva") as HTMLSelectElement).value);
        const refund = Math.min(iva * share, EFECTIVA_CAP_UVT * UVT_2026 * people);
        const extra = after - today - refund;
        root.querySelector<HTMLElement>("[data-refund-row]")!.hidden = share === 0;
        out("today").textContent = formatCOP(today);
        out("after").textContent = formatCOP(Math.round(after));
        out("refund").textContent = `−${formatCOP(Math.round(refund))}`;
        out("label").textContent = extra < 0 ? "Quedarías a favor al mes" : "Pagarías de más al mes";
        out("extra").textContent = formatCOP(Math.round(Math.abs(extra)));
        out("year").textContent = formatCOP(Math.round(Math.abs(extra) * 12));
        return extra < 0 ? `Quedarías ${formatCOP(Math.round(-extra))} a favor al mes.` : `Pagarías ${formatCOP(Math.round(extra))} más al mes.`;
    });

    wire("renta", (form, out) => {
        const salary = money(form, "salario");
        const dependents = Number((form.elements.namedItem("dependientes") as HTMLSelectElement).value);
        const now = rentaFor(salary, dependents, "now");
        const after = rentaFor(salary, dependents, "new");
        const diff = after.tax - now.tax;
        out("now").textContent = formatCOP(now.tax);
        out("new").textContent = formatCOP(after.tax);
        out("now-bracket").textContent = now.tax ? `Tramo de ${pct(now.bracket.rate)}` : "No pagas";
        out("new-bracket").textContent = after.tax ? `Tramo de ${pct(after.bracket.rate)}` : "No pagas";
        out("label").textContent = diff < 0 ? "Pagarías de menos al año" : "Pagarías de más al año";
        out("diff").textContent = formatCOP(Math.abs(diff));
        out("month").textContent = formatCOP(Math.round(Math.abs(diff) / 12));
        const keys = ["income", "health", "pension", "solidarity", "exempt", "dependents"] as const;
        for (const [side, data] of [["now", now], ["new", after]] as const) {
            for (const key of keys) {
                document.querySelector<HTMLElement>(`[data-${side}="${key}"]`)!.textContent = formatCOP(Math.round(data[key]));
            }
            document.querySelector<HTMLElement>(`[data-${side}="uvt"]`)!.textContent = data.taxableUvt.toLocaleString("es-CO", { maximumFractionDigits: 1 });
        }
        return `Renta hoy ${formatCOP(now.tax)}, con el proyecto ${formatCOP(after.tax)}.`;
    });

    wire("salud", (form, out, root) => {
        const salary = money(form, "salario");
        const independent = (form.elements.namedItem("independiente") as HTMLInputElement).checked;
        const now = healthNow(salary, independent);
        const after = healthNew(salary, independent);
        const diff = after.value - now;
        out("salary-label").textContent = independent ? "Tu ingreso base de cotización" : "Tu salario mensual";
        root.querySelector<HTMLElement>("[data-independent-hint]")!.hidden = !independent;
        out("now").textContent = formatCOP(now);
        out("new-label").textContent = `Con el proyecto (${pct(after.rate)})`;
        out("new").textContent = formatCOP(after.value);
        out("diff").textContent = formatCOP(diff);
        out("year").textContent = formatCOP(diff * 12);
        const employer = root.querySelector<HTMLElement>("[data-employer]")!;
        employer.hidden = independent;
        const rate = employerNew(salary) - employerNow(salary);
        out("employer").textContent = rate > 0 ? `+${formatCOP(salary * rate)}` : "$0";
        out("employer-note").textContent =
            rate > 0 ? `Al mes, en salud, SENA e ICBF (${pct(rate)})` : employerNow(salary) ? "Ya paga salud, SENA e ICBF por ti" : "Sigue exonerada de salud, SENA e ICBF";
        return `Te descontarían ${formatCOP(diff)} más al mes.`;
    });

    wire("vicios", (form, out, root) => {
        const choice = form.querySelector<HTMLInputElement>('input[name="producto"]:checked')!;
        const price = money(form, "precio");
        const quantity = Math.max(0, Number((form.elements.namedItem("cantidad") as HTMLInputElement).value) || 0);
        const rise = Number(choice.dataset.rise);
        const unit = choice.dataset.unit!;
        out("unit-label").textContent = `${unit === "cerveza" ? "Cervezas" : unit === "botella" ? "Botellas" : unit === "cajetilla" ? "Cajetillas" : "Unidades"} al mes`;
        out("price").textContent = formatCOP(Math.round(price * (1 + rise)));
        out("extra").textContent = formatCOP(Math.round(price * rise * quantity));
        out("year").textContent = formatCOP(Math.round(price * rise * quantity * 12));
        void root;
        return `Gastarías ${formatCOP(Math.round(price * rise * quantity))} más al mes.`;
    });

    // Al cambiar de producto, pone su precio y cantidad de ejemplo
    for (const radio of document.querySelectorAll<HTMLInputElement>('[data-calc="vicios"] input[name="producto"]')) {
        radio.addEventListener("change", () => {
            const form = radio.form!;
            (form.elements.namedItem("precio") as HTMLInputElement).value = formatNumber(Number(radio.dataset.price));
            (form.elements.namedItem("cantidad") as HTMLInputElement).value = radio.dataset.quantity!;
            form.dispatchEvent(new Event("input"));
        });
    }
</script>

