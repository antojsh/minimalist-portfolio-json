---
import Layout from "@/layouts/Layout.astro";
import "@/styles/tools.css";
import Topbar from "@/components/tool/Topbar.astro";
import Faq from "@/components/tool/Faq.astro";
import Colophon from "@/components/tool/Colophon.astro";
import { IMPUESTOS_REVIEW, addIva, removeIva } from "@/lib/impuestos";
import { formatCOP, formatNumber, getUvt } from "@/lib/uvt";
import { longDate, toolJsonLd } from "@/lib/seo";

const YEAR = Number(IMPUESTOS_REVIEW.slice(0, 4));
const uvt = getUvt(YEAR);
const example = addIva(100_000, 0.19);
const rows = [10_000, 50_000, 100_000, 500_000, 1_000_000, 5_000_000].map((value) => ({
    value,
    added: addIva(value, 0.19),
    removed: removeIva(value, 0.19),
}));

const faqs = [
    {
        question: "¿Cómo se calcula el IVA del 19 %?",
        answer: `Multiplica el valor sin IVA por 0,19 para saber el impuesto, o por 1,19 para tener el total. Por ejemplo, ${formatCOP(100_000)} más IVA son ${formatCOP(example.iva)} de impuesto y ${formatCOP(example.total)} en total.`,
    },
    {
        question: "¿Cómo le quito el IVA a un precio?",
        answer: `Divide el precio entre 1,19. Así, un precio de ${formatCOP(119_000)} con IVA tiene una base de ${formatCOP(100_000)} y un IVA de ${formatCOP(19_000)}. No sirve restar el 19 % del total, porque el IVA se calculó sobre la base, no sobre el total.`,
    },
    {
        question: "¿Qué tarifas de IVA hay en Colombia?",
        answer: "La general es del 19 %. Hay una tarifa del 5 % para la lista de bienes y servicios de los artículos 468-1 y 468-3 del Estatuto Tributario. Además, hay bienes exentos (tarifa 0 % con derecho a devolución) y bienes excluidos, que no causan IVA.",
    },
    {
        question: "¿Qué diferencia hay entre exento y excluido?",
        answer: "Un bien exento está gravado a la tarifa del 0 %: quien lo vende puede pedir devolución del IVA que pagó en sus compras. Un bien excluido no causa IVA y quien lo vende no puede recuperar el IVA de sus costos.",
    },
    {
        question: "¿Quién debe cobrar IVA?",
        answer: `Los responsables de IVA. Una persona natural no es responsable si, entre otras condiciones, sus ingresos brutos del año anterior y del año en curso son menores a 3.500 UVT (${formatCOP(3_500 * uvt.value)} en ${YEAR}) y no tiene más de un establecimiento de comercio (art. 437 del Estatuto Tributario).`,
    },
    {
        question: "¿El IVA se calcula antes o después de los descuentos?",
        answer: "Después. Los descuentos que aparecen en la factura y no están condicionados a nada se restan del precio antes de calcular el IVA, así que el impuesto se cobra sobre el valor que realmente pagas.",
    },
];

const site = Astro.site?.href ?? "/";
const path = "/calculadora-iva";
const title = "Calculadora de IVA en Colombia: agrega o quita el 19 % a un precio";
const description = "Suma el IVA a un valor o sácalo de un precio que ya lo incluye, con el 19 %, el 5 % o cualquier tarifa. Con la fórmula y una tabla rápida.";
const ogPath = "/og/calculadora-iva.png";
const jsonLd = toolJsonLd({ site, path, title, description, name: "Calculadora de IVA", crumb: "Calculadora de IVA", review: IMPUESTOS_REVIEW, image: ogPath, faqs });
---

<Layout title={title} description={description} image={ogPath} imageAlt="Calculadora de IVA del 19 %" imageWidth={1200} imageHeight={630} canvas={false} jsonLd={jsonLd}>
    <div class="tool-flag" aria-hidden="true"></div>

    <main class="tool">
        <Topbar
            crumb="Calculadora de IVA"
            links={[
                { href: "#calculadora", label: "Calculadora" },
                { href: "#tabla", label: "Tabla" },
                { href: "#formula", label: "Fórmula" },
                { href: "#preguntas", label: "Preguntas" },
            ]}
        />

        <section class="hero">
            <h1>Calculadora de <span>IVA</span></h1>
            <p class="lead">
                Para sumarle el IVA a un valor, <strong>multiplica por 1,19</strong>. Para quitárselo a un precio que ya lo
                trae, <strong>divide entre 1,19</strong>. Aquí lo haces al instante, con el 19 %, el 5 % o la tarifa que
                necesites.
            </p>
            <p class="updated">Actualizado el <time datetime={IMPUESTOS_REVIEW}>{longDate(IMPUESTOS_REVIEW)}</time> · Art. 468 del Estatuto Tributario</p>
        </section>

        <section id="calculadora" class="workbench" aria-labelledby="calculadora-titulo">
            <h2 id="calculadora-titulo" class="sr-only">Calcula el IVA</h2>
            <form class="form" data-form>
                <fieldset class="field">
                    <legend>¿Qué necesitas?</legend>
                    <div class="options">
                        <label class="option"><input type="radio" name="modo" value="sumar" checked /><span><strong>Agregar IVA</strong><small>Tengo el valor sin IVA</small></span></label>
                        <label class="option"><input type="radio" name="modo" value="quitar" /><span><strong>Quitar IVA</strong><small>El precio ya incluye IVA</small></span></label>
                    </div>
                </fieldset>
                <div class="field">
                    <label for="valor" data-amount-label>Valor sin IVA</label>
                    <div class="money big">
                        <span aria-hidden="true">$</span>
                        <input id="valor" name="valor" type="text" inputmode="numeric" autocomplete="off" value={formatNumber(100_000)} />
                    </div>
                </div>
                <fieldset class="field">
                    <legend>Tarifa</legend>
                    <div class="rates">
                        {[19, 5, 0].map((rate) => (
                            <label class="rate"><input type="radio" name="tarifa" value={rate} checked={rate === 19} /><span>{rate} %</span></label>
                        ))}
                        <label class="rate custom">
                            <input type="radio" name="tarifa" value="otra" />
                            <span>Otra</span>
                        </label>
                        <div class="money custom-rate">
                            <input name="otra" type="text" inputmode="decimal" aria-label="Otra tarifa en porcentaje" placeholder="8" />
                            <span aria-hidden="true">%</span>
                        </div>
                    </div>
                </fieldset>
            </form>

            <div class="result">
                <div class="ticket">
                    <p class="ticket-head">Factura de venta</p>
                    <dl class="ticket-lines">
                        <div><dt>Subtotal</dt><dd data-out="base">{formatCOP(example.base)}</dd></div>
                        <div><dt data-out="rate">IVA 19 %</dt><dd data-out="iva">{formatCOP(example.iva)}</dd></div>
                    </dl>
                    <div class="ticket-total">
                        <span>Total</span>
                        <b data-out="total">{formatCOP(example.total)}</b>
                    </div>
                    <p class="ticket-note" data-out="note">Valor sin IVA × 1,19</p>
                    <button type="button" class="copy" data-copy>Copiar resultado</button>
                </div>
                <p class="sr-only" aria-live="polite" data-live></p>
            </div>
        </section>

        <section id="tabla" aria-labelledby="tabla-titulo">
            <header class="head">
                <h2 id="tabla-titulo">Tabla rápida del IVA del 19 %</h2>
                <p>Lo que más se pregunta: cuánto queda con IVA y cuánto es la base de un precio que ya lo incluye.</p>
            </header>
            <div class="table-wrap">
                <table class="amounts">
                    <thead>
                        <tr>
                            <th scope="col">Valor</th>
                            <th scope="col" class="num">Más IVA</th>
                            <th scope="col" class="num">IVA</th>
                            <th scope="col" class="num">Si ya lo incluye, base</th>
                        </tr>
                    </thead>
                    <tbody>
                        {
                            rows.map(({ value, added, removed }) => (
                                <tr>
                                    <th scope="row">{formatCOP(value)}</th>
                                    <td class="num strong">{formatCOP(added.total)}</td>
                                    <td class="num">{formatCOP(added.iva)}</td>
                                    <td class="num">{formatCOP(removed.base)}</td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section id="formula" aria-labelledby="formula-titulo">
            <header class="head">
                <h2 id="formula-titulo">Las dos fórmulas del IVA</h2>
                <p>El error más común es restar el 19 % de un precio con IVA. Así no da: hay que dividir.</p>
            </header>
            <div class="formulas">
                <div class="formula">
                    <p class="formula-label">Agregar IVA</p>
                    <p class="formula-eq">Total = Base × 1,19</p>
                    <p class="formula-ex">{formatCOP(100_000)} × 1,19 = {formatCOP(119_000)}</p>
                </div>
                <div class="formula">
                    <p class="formula-label">Quitar IVA</p>
                    <p class="formula-eq">Base = Total ÷ 1,19</p>
                    <p class="formula-ex">{formatCOP(119_000)} ÷ 1,19 = {formatCOP(100_000)}</p>
                </div>
                <div class="formula wrong">
                    <p class="formula-label">Lo que no se hace</p>
                    <p class="formula-eq">Total − 19 %</p>
                    <p class="formula-ex">{formatCOP(119_000)} − 19 % = {formatCOP(96_390)}. Faltan {formatCOP(3_610)}.</p>
                </div>
            </div>
        </section>

        <Faq faqs={faqs} subject="Calculadora de IVA" />

        <Colophon
            sources={[{ label: "Estatuto Tributario (arts. 437, 468, 468-1 y 468-3)" }]}
            related={[
                { href: "/calculadora-4x1000", label: "Calculadora del 4x1000" },
                { href: "/retencion-en-la-fuente", label: "Retención en la fuente" },
                { href: "/uvt", label: "UVT" },
            ]}
        />
    </main>
</Layout>

<script>
    import { addIva, removeIva } from "@/lib/impuestos";
    import { formatCOP, formatNumber, parseCOP, parseDecimal } from "@/lib/uvt";

    const form = document.querySelector<HTMLFormElement>("[data-form]")!;
    const amount = form.elements.namedItem("valor") as HTMLInputElement;
    const other = form.elements.namedItem("otra") as HTMLInputElement;
    const out = (key: string) => document.querySelector<HTMLElement>(`[data-out="${key}"]`)!;
    const live = document.querySelector<HTMLElement>("[data-live]")!;
    let text = "";

    amount.addEventListener("input", () => {
        const value = parseCOP(amount.value);
        amount.value = value ? formatNumber(value) : "";
    });
    other.addEventListener("focus", () => ((form.querySelector('[name="tarifa"][value="otra"]') as HTMLInputElement).checked = true));

    function update(): void {
        const mode = (form.querySelector<HTMLInputElement>('[name="modo"]:checked')?.value ?? "sumar") as "sumar" | "quitar";
        const choice = form.querySelector<HTMLInputElement>('[name="tarifa"]:checked')?.value ?? "19";
        const ratePct = choice === "otra" ? Math.min(100, parseDecimal(other.value)) : Number(choice);
        const rate = ratePct / 100;
        const value = parseCOP(amount.value);
        const result = mode === "sumar" ? addIva(value, rate) : removeIva(value, rate);
        const factor = String(Math.round((1 + rate) * 10000) / 10000).replace(".", ",");
        const label = `${String(ratePct).replace(".", ",")} %`;
        document.querySelector("[data-amount-label]")!.textContent = mode === "sumar" ? "Valor sin IVA" : "Precio con IVA incluido";
        out("base").textContent = formatCOP(result.base);
        out("rate").textContent = `IVA ${label}`;
        out("iva").textContent = formatCOP(result.iva);
        out("total").textContent = formatCOP(result.total);
        out("note").textContent = mode === "sumar" ? `Valor sin IVA × ${factor}` : `Precio con IVA ÷ ${factor}`;
        text = `Subtotal: ${formatCOP(result.base)}\nIVA ${label}: ${formatCOP(result.iva)}\nTotal: ${formatCOP(result.total)}`;
        live.textContent = `Base ${formatCOP(result.base)}, IVA ${formatCOP(result.iva)}, total ${formatCOP(result.total)}.`;
    }

    form.addEventListener("input", update);
    form.addEventListener("change", update);
    const copy = document.querySelector<HTMLButtonElement>("[data-copy]")!;
    copy.addEventListener("click", async () => {
        try {
            await navigator.clipboard.writeText(text);
            copy.textContent = "Copiado";
        } catch {
            copy.textContent = "No se pudo copiar";
        }
        setTimeout(() => (copy.textContent = "Copiar resultado"), 1500);
    });
    update();
</script>

<style>
    .rates {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    .rate {
        position: relative;
        cursor: pointer;
    }

    .rate input {
        position: absolute;
        opacity: 0;
    }

    .rate span {
        display: block;
        min-width: 64px;
        padding: 12px 16px;
        border: 1px solid var(--line-strong);
        border-radius: 12px;
        background: var(--sheet);
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 700;
        text-align: center;
    }

    .rate input:checked + span {
        border-color: var(--ink);
        background: var(--ink);
        color: #fff;
    }

    .rate input:focus-visible + span {
        outline: 2px solid var(--ink);
        outline-offset: 3px;
    }

    .custom-rate {
        width: 110px;
    }

    .result {
        position: sticky;
        top: 24px;
    }

    /* Tiquete de caja con borde dentado */
    .ticket {
        padding: 28px 28px 44px;
        background: #fffdf9;
        box-shadow: 0 0 0 1px var(--line);
        font-family: var(--font-mono);
        -webkit-mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 18px 100%;
        mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 18px 100%;
    }

    .ticket-head {
        padding-bottom: 14px;
        border-bottom: 2px dashed var(--line-strong);
        color: var(--ink);
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-align: center;
        text-transform: uppercase;
    }

    .ticket-lines {
        display: grid;
        gap: 10px;
        margin-top: 16px;
    }

    .ticket-lines div {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        color: var(--text-soft);
    }

    .ticket-lines dd {
        margin: 0;
        color: var(--ink);
        font-weight: 600;
    }

    .ticket-total {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        margin-top: 18px;
        padding-top: 14px;
        border-top: 2px dashed var(--line-strong);
        color: var(--ink);
        font-weight: 600;
    }

    .ticket-total b {
        color: var(--red);
        font-family: var(--font-display);
        font-size: clamp(2.2rem, 1.8rem + 1.6vw, 3rem);
        font-variant-numeric: tabular-nums;
        letter-spacing: -0.04em;
    }

    .ticket-note {
        margin-top: 8px;
        color: var(--muted);
        font-size: 0.82rem;
        text-align: right;
    }

    .copy {
        width: 100%;
        margin-top: 18px;
        padding: 11px;
        border: 1px solid var(--line-strong);
        border-radius: 10px;
        background: transparent;
        color: var(--ink);
        font: inherit;
        font-family: var(--font-body);
        font-weight: 600;
        cursor: pointer;
    }

    .copy:hover {
        border-color: var(--ink);
    }

    .table-wrap {
        overflow-x: auto;
    }

    .table-wrap table {
        min-width: 560px;
    }

    .formulas {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
    }

    .formula {
        padding: 22px;
        border-radius: 18px;
        background: var(--board);
    }

    .formula.wrong {
        background: var(--red-soft);
    }

    .formula-label {
        color: var(--amber);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .wrong .formula-label {
        color: var(--red-ink);
    }

    .formula-eq {
        margin-top: 8px;
        color: #fff;
        font-family: var(--font-display);
        font-size: 1.6rem;
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .wrong .formula-eq {
        color: var(--red-ink);
        text-decoration: line-through;
    }

    .formula-ex {
        margin-top: 6px;
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.9rem;
    }

    .wrong .formula-ex {
        color: var(--red-ink);
    }

    @media (max-width: 1023px) {
        .result {
            position: static;
        }

        .ticket {
            max-width: 460px;
        }

        .formulas {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
