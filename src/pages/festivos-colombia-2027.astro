</Layout>

<script>
    import {
        MONTHS,
        WEEKDAYS,
        capitalize,
        daysBetween,
        formatLong,
        formatRange,
        getHolidays,
        getLongWeekends,
        todayInColombia,
        toDate,
    } from "@/lib/festivos";

    const today = todayInColombia();
    const date = toDate(today);
    const year = date.getUTCFullYear();
    const holidays = [...getHolidays(year), ...getHolidays(year + 1)];
    const holiday = holidays.find((item) => item.date === today);
    const next = holidays.find((item) => item.date > today);
    const findBridge = (day: string) =>
        getLongWeekends(Number(day.slice(0, 4))).find(({ start, end }) => start <= day && day <= end);

    const card = document.querySelector<HTMLElement>("[data-today]");

    if (card != null) {
        const set = (name: string, text: string) => {
            const element = card.querySelector(`[data-${name}]`);
            if (element != null) element.textContent = text;
        };

        set("month", `${MONTHS[date.getUTCMonth()]} ${year}`);
        set("day", String(date.getUTCDate()));
        set("weekday", WEEKDAYS[date.getUTCDay()]);

        const dayOfWeek = date.getUTCDay();

        if (holiday != null) {
            set("answer", "¡Hoy es festivo!");
            set("status", holiday.name);
        } else {
            set("answer", "Hoy no es festivo");
            set(
                "status",
                findBridge(today) != null
                    ? "Pero estás de puente: aprovecha."
                    : dayOfWeek === 0
                      ? "Es domingo, día de descanso."
                      : dayOfWeek === 6
                        ? "Es sábado."
                        : "Es día hábil.",
            );
        }

        if (next != null) {
            const days = daysBetween(today, next.date);
            const nextYear = next.date.slice(0, 4);
            const bridge = findBridge(next.date);
            const when = `${formatLong(next.date)}${Number(nextYear) !== year ? ` de ${nextYear}` : ""}`;
            set("next-date", capitalize(when));
            set("next-name", next.name);
            set("countdown", days === 1 ? "Mañana" : `En ${days} días`);
            set("bridge", bridge ? `Puente ${formatRange(bridge.start, bridge.end)}` : "");
        }

        card.classList.toggle("is-holiday", holiday != null);
        card.classList.add("is-ready");
    }

    // Durante el año de la página se marcan los festivos que ya pasaron, el próximo y el día de hoy
    const pageYear = Number(document.querySelector<HTMLElement>("main")?.dataset.year);

    if (year === pageYear) {
        document.querySelectorAll<HTMLElement>("tr[data-date]").forEach((row) => {
            const { date: rowDate = "" } = row.dataset;
            row.classList.toggle("is-past", rowDate < today);
            row.classList.toggle("is-today", rowDate === today);
            row.classList.toggle("is-next", rowDate === next?.date);
        });

        const [, month, day] = today.split("-").map(Number);
        document.querySelector(`[data-month="${month}"] .cal-days li:nth-child(${day})`)?.classList.add("is-today");
    }

    document.querySelector("[data-print]")?.addEventListener("click", () => window.print());
</script>

