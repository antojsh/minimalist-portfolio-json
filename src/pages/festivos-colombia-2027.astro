---
import Layout from "@/layouts/Layout.astro";
import { basics } from "@cv";
import {
    LAST_REVIEW,
    MONTHS,
    WEEKDAYS,
    addDays,
    capitalize,
    countWorkdays,
    dayOf,
    formatDays,
    formatLong,
    formatRange,
    formatShort,
    formatWeekdayDay,
    getEaster,
    getHolidays,
    getLongWeekends,
    getSpecialDates,
    getVacationPlans,
    isWeekend,
    joinList,
    weekdayOf,
    type Holiday,
} from "@/lib/festivos";

const YEAR = 2027;

const LAW_51_URL = "https://www.funcionpublica.gov.co/eva/gestornormativo/norma.php?i=4954";
const LAW_2578_URL =
    "https://www.mininterior.gov.co/noticias/gobierno-sanciona-ley-que-convierte-el-9-de-julio-en-nuevo-festivo-nacional/";

const holidays = getHolidays(YEAR);
const longWeekends = getLongWeekends(YEAR);
const plans = getVacationPlans(YEAR);
const specialDates = getSpecialDates(YEAR);
const workdays = countWorkdays(YEAR);
const easter = getEaster(YEAR);

const byDate = new Map(holidays.map((holiday) => [holiday.date, holiday] as const));
const movable = holidays.filter(({ kind }) => kind === "trasladable");
const fixed = holidays.filter(({ kind }) => kind === "fijo");
const holyWeek = holidays.filter(({ kind }) => kind === "semana-santa");
const onSaturday = holidays.filter(({ date }) => weekdayOf(date) === 6);
const onSunday = holidays.filter(({ movedFrom }) => movedFrom != null && weekdayOf(movedFrom) === 0);
const onWeekdays = holidays.filter(({ date }) => !isWeekend(date)).length;
const newest = holidays.find(({ since }) => since != null && since >= YEAR - 1);
const first = holidays[0];
const mothersDay = specialDates.find(({ name }) => name === "Día de la Madre")!;
const daysOf = ({ start, days }: { start: string; days: number }) =>
    Array.from({ length: days }, (_, index) => addDays(start, index));

// Días de fin de semana que se suman a un puente (se pintan en el calendario)
const bridgeDays = new Set(longWeekends.flatMap(daysOf).filter((date) => !byDate.has(date)));

const months = MONTHS.map((name, index) => {
    const prefix = `${YEAR}-${String(index + 1).padStart(2, "0")}`;
    const length = new Date(Date.UTC(YEAR, index + 1, 0)).getUTCDate();
    return {
        name,
        number: index + 1,
        offset: weekdayOf(`${prefix}-01`) + 1,
        holidays: holidays.filter(({ date }) => date.startsWith(prefix)),
        days: Array.from({ length }, (_, day) => {
            const date = `${prefix}-${String(day + 1).padStart(2, "0")}`;
            return { holiday: byDate.get(date), bridge: bridgeDays.has(date), sunday: weekdayOf(date) === 0 };
        }),
    };
});

const semesters = [
    { title: "Enero a junio", months: months.slice(0, 6) },
    { title: "Julio a diciembre", months: months.slice(6) },
];

const describe = ({ date, kind, movedFrom }: Holiday) => {
    if (movedFrom) return `Se corre del ${formatLong(movedFrom)}`;
    if (kind === "trasladable") return "Ya cae lunes, no se mueve";
    if (kind === "semana-santa") return "Semana Santa";
    if (isWeekend(date)) return `Cae ${WEEKDAYS[weekdayOf(date)]} y no se corre al lunes`;
    return "Fecha fija";
};

const restName = (list: Holiday[]) =>
    joinList([...new Set(list.map(({ name, kind }) => (kind === "semana-santa" ? "Semana Santa" : name)))]);


const stripDay = (date: string, type: string) => ({
    type,
    weekday: WEEKDAYS[weekdayOf(date)].charAt(0).toUpperCase(),
    day: dayOf(date),
});

const faqs = [
    {
        question: `¿Cuántos festivos tiene Colombia en ${YEAR}?`,
        answer: `Colombia tiene ${holidays.length} festivos en ${YEAR}: ${fixed.length} de fecha fija, ${holyWeek.length} de Semana Santa y ${movable.length} que siempre se celebran en lunes por la Ley Emiliani.${newest ? ` Desde ${newest.since} se suma el Día de la Virgen de Chiquinquirá (Ley 2578 de 2026).` : ""}`,
    },
    ...(newest
        ? [
              {
                  question: "¿Cuál es el nuevo festivo de Colombia?",
                  answer: `El Día de Nuestra Señora del Rosario de Chiquinquirá, creado por la Ley 2578 del 1 de junio de 2026. Se conmemora el 9 de julio y, como los festivos de la Ley Emiliani, se descansa el lunes siguiente: en ${YEAR} es el ${formatLong(newest.date)}.`,
              },
          ]
        : []),
    {
        question: `¿Cuántos puentes festivos hay en ${YEAR}?`,
        answer: `Hay ${longWeekends.length} fines de semana largos: ${longWeekends.filter(({ days }) => days === 3).length} puentes de tres días y la Semana Santa, que va ${formatRange(holyWeek[0].date, addDays(holyWeek[0].date, 3))}.`,
    },
    {
        question: `¿Cuándo es Semana Santa en ${YEAR}?`,
        answer: `Va del Domingo de Ramos, ${formatLong(addDays(easter, -7)).replace("domingo ", "")}, al Domingo de Resurrección, ${formatLong(easter).replace("domingo ", "")}. Los festivos son el Jueves Santo (${dayOf(holyWeek[0].date)} de marzo) y el Viernes Santo (${dayOf(holyWeek[1].date)} de marzo).`,
    },
    {
        question: `¿Qué festivos de ${YEAR} caen en fin de semana?`,
        answer: `${joinList(onSaturday.map(({ name, date }) => `${name} (${formatLong(date).replace("sábado ", "")})`))} caen sábado y no se corren al lunes.${onSunday.map(({ name, date, movedFrom }) => ` ${name} cae ${formatLong(movedFrom!)}, pero por la Ley Emiliani se descansa el ${formatLong(date)}.`).join("")}`,
    },
    {
        question: `¿Cuántos días hábiles tiene ${YEAR} en Colombia?`,
        answer: `${workdays} días hábiles de lunes a viernes: el año tiene ${workdays + onWeekdays} días entre semana y ${onWeekdays} festivos caen en ellos.`,
    },
    {
        question: "¿Por qué los festivos en Colombia se pasan al lunes?",
        answer: `Por la Ley 51 de 1983, conocida como Ley Emiliani. Dice que varios festivos, "cuando no caigan en día lunes se trasladarán al lunes siguiente a dicho día". En ${YEAR} son ${movable.length}; los de fecha fija y los de Semana Santa no se mueven.`,
    },
    {
        question: `¿Cuánto pagan por trabajar un festivo en ${YEAR}?`,
        answer: `Con la reforma laboral (Ley 2466 de 2025), el recargo por trabajar un domingo o festivo es del 90 % sobre el valor de la hora ordinaria hasta el 30 de junio de ${YEAR}, y del 100 % desde el 1 de julio de ${YEAR}.`,
    },
    {
        question: "¿El 24 y el 31 de diciembre son festivos?",
        answer: `No. En ${YEAR} el 24 y el 31 de diciembre caen ${WEEKDAYS[weekdayOf(`${YEAR}-12-24`)]} y son días hábiles, aunque algunas empresas dan el día. El festivo de esa semana es la Navidad, el ${formatLong(`${YEAR}-12-25`)}.`,
    },
    {
        question: "¿El Día de la Madre es festivo?",
        answer: `No. En Colombia se celebra el segundo domingo de mayo: en ${YEAR} es el ${formatLong(mothersDay.date)}.`,
    },
];

const site = Astro.site?.href ?? "/";
const pageUrl = new URL("/festivos-colombia-2027", site).href;
const title = `Festivos en Colombia ${YEAR}: lista, calendario y puentes`;
const description = `Los ${holidays.length} festivos de Colombia en ${YEAR} con su día de la semana, los ${longWeekends.length} puentes, Semana Santa y el nuevo festivo de la Virgen de Chiquinquirá.`;
const image = new URL("/og/festivos-colombia-2027.png", site).href;
const personId = new URL("/#person", site).href;

const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebPage",
            "@id": `${pageUrl}#webpage`,
            url: pageUrl,
            name: title,
            description,
            inLanguage: "es-CO",
            isPartOf: { "@id": new URL("/#website", site).href },
            author: { "@id": personId },
            dateModified: LAST_REVIEW,
            primaryImageOfPage: { "@type": "ImageObject", url: image, width: 1200, height: 630 },
            about: { "@type": "Country", name: "Colombia" },
            mainEntity: { "@id": `${pageUrl}#festivos` },
            breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
        },
        {
            "@type": "ItemList",
            "@id": `${pageUrl}#festivos`,
            name: `Festivos de Colombia en ${YEAR}`,
            numberOfItems: holidays.length,
            itemListOrder: "https://schema.org/ItemListOrderAscending",
            itemListElement: holidays.map((holiday, index) => ({
                "@type": "ListItem",
                position: index + 1,
                name: `${holiday.name}: ${formatLong(holiday.date)} de ${YEAR}`,
            })),
        },
        {
            "@type": "Dataset",
            "@id": `${pageUrl}#dataset`,
            name: `Festivos de Colombia ${YEAR}`,
            description: `Fechas de los ${holidays.length} días festivos de Colombia en ${YEAR}, con el día de la semana y la fecha original de los que se trasladan al lunes por la Ley 51 de 1983 (Ley Emiliani) y la Ley 2578 de 2026.`,
            url: pageUrl,
            temporalCoverage: `${YEAR}-01-01/${YEAR}-12-31`,
            spatialCoverage: { "@type": "Country", name: "Colombia" },
            creator: { "@id": personId },
            dateModified: LAST_REVIEW,
            isAccessibleForFree: true,
            distribution: [
                {
                    "@type": "DataDownload",
                    encodingFormat: "text/calendar",
                    contentUrl: new URL("/festivos-colombia-2027.ics", site).href,
                },
                {
                    "@type": "DataDownload",
                    encodingFormat: "application/json",
                    contentUrl: new URL("/festivos-colombia-2027.json", site).href,
                },
            ],
        },
        {
            "@type": "FAQPage",
            "@id": `${pageUrl}#preguntas`,
            mainEntity: faqs.map(({ question, answer }) => ({
                "@type": "Question",
                name: question,
                acceptedAnswer: { "@type": "Answer", text: answer },
            })),
        },
        {
            "@type": "BreadcrumbList",
            "@id": `${pageUrl}#breadcrumb`,
            itemListElement: [
                { "@type": "ListItem", position: 1, name: "Inicio", item: site },
                { "@type": "ListItem", position: 2, name: `Festivos Colombia ${YEAR}`, item: pageUrl },
            ],
        },
        {
            "@type": "Person",
            "@id": personId,
            name: basics.name,
            url: site,
            sameAs: basics.profiles.map(({ url }) => url),
        },
    ],
};
---

<Layout
    title={title}
    description={description}
    image="/og/festivos-colombia-2027.png"
    imageAlt={`Calendario de los ${holidays.length} festivos de Colombia en ${YEAR}`}
    imageWidth={1200}
    imageHeight={630}
    canvas={false}
    jsonLd={jsonLd}
>
    <div class="flag" aria-hidden="true"></div>

    <main data-year={YEAR}>
        <header class="topbar no-print">
            <nav aria-label="Ruta de navegación">
                <ol class="crumbs">
                    <li>
                        <a href="/"><span class="monogram" aria-hidden="true">AS</span>antojsh.dev</a>
                    </li>
                    <li aria-current="page">Festivos {YEAR}</li>
                </ol>
            </nav>
            <nav class="toc" aria-label="En esta página">
                <a href="#lista">Lista</a>
                <a href="#calendario">Calendario</a>
                <a href="#puentes">Puentes</a>
                <a href="#vacaciones">Vacaciones</a>
                <a href="#preguntas">Preguntas</a>
            </nav>
        </header>

        <section class="hero">
            <div class="intro">
                <h1>Festivos en Colombia <span>{YEAR}</span></h1>
                <p class="lead">
                    Colombia tiene <strong>{holidays.length} festivos</strong> en {YEAR}.
                    De ellos, {movable.length} se celebran en lunes por la Ley Emiliani, así que el año trae
                    <strong>{longWeekends.length} fines de semana largos</strong>.
                    {
                        newest && (
                            <>
                                Ojo: desde {newest.since} hay un festivo nuevo, la
                                <a href="#ley-emiliani">Virgen de Chiquinquirá</a>, que en {YEAR} cae el
                                {formatLong(newest.date)}.
                            </>
                        )
                    }
                </p>
                <div class="actions no-print">
                    <a class="button" href="/festivos-colombia-2027.ics">
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                            <path
                                fill="none"
                                stroke="currentColor"
                                stroke-linecap="round"
                                stroke-width="1.8"
                                d="M7 3v3m10-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm7 7v5m-2.5-2.5h5"
                            ></path>
                        </svg>
                        Añadir a mi calendario
                    </a>
                    <button class="button ghost" type="button" data-print>Imprimir calendario</button>
                </div>
                <p class="updated">
                    Actualizado el <time datetime={LAST_REVIEW}>{formatLong(LAST_REVIEW).replace(/^\S+ /, "")} de {LAST_REVIEW.slice(0, 4)}</time>
                    · Calculado con la <a href={LAW_51_URL} rel="noopener">Ley 51 de 1983</a> y la
                    <a href={LAW_2578_URL} rel="noopener">Ley 2578 de 2026</a>
                </p>
            </div>

            <aside class="today no-print" aria-labelledby="hoy" data-today>
                <h2 id="hoy">¿Hoy es festivo?</h2>
                <div class="today-body">
                    <div class="tile" aria-hidden="true">
                        <div class="sheet page">
                            <span class="band" data-month></span>
                            <span class="day" data-day></span>
                            <span class="weekday" data-weekday></span>
                        </div>
                        <div class="sheet cover">
                            <span class="band">Almanaque</span>
                            <span class="day">{YEAR}</span>
                            <span class="weekday">Colombia</span>
                        </div>
                        <span class="rings"></span>
                    </div>
                    <div class="today-info" aria-live="polite">
                        <p class="verdict" data-answer>Revisando el calendario…</p>
                        <p class="status" data-status></p>
                        <div class="next">
                            <p class="next-label">
                                Próximo festivo <span class="countdown" data-countdown></span>
                            </p>
                            <p class="next-date" data-next-date>{capitalize(formatLong(first.date))}</p>
                            <p class="next-name" data-next-name>{first.name}</p>
                            <p class="next-bridge" data-bridge></p>
                        </div>
                    </div>
                </div>
            </aside>

            <dl class="facts">
                <div><dt>festivos en el año</dt><dd>{holidays.length}</dd></div>
                <div><dt>fines de semana largos</dt><dd>{longWeekends.length}</dd></div>
                <div><dt>días hábiles de lunes a viernes</dt><dd>{workdays}</dd></div>
                <div><dt>festivos caen sábado</dt><dd>{onSaturday.length}</dd></div>
            </dl>
        </section>

        <section id="lista" class="no-print" aria-labelledby="lista-titulo">
            <header class="head">
                <h2 id="lista-titulo">Los {holidays.length} festivos de {YEAR}, mes a mes</h2>
                <p>
                    Con su día de la semana. Cuando la Ley Emiliani corre un festivo al lunes, también
                    te dejo la fecha original.
                </p>
            </header>

            <div class="semesters">
                {
                    semesters.map((semester) => (
                        <table>
                            <caption class="sr-only">Festivos de {semester.title.toLowerCase()}</caption>
                            <thead class="sr-only">
                                <tr>
                                    <th scope="col">Mes</th>
                                    <th scope="col">Fecha</th>
                                    <th scope="col">Festivo</th>
                                </tr>
                            </thead>
                            {semester.months.map((month) => (
                                <tbody class:list={{ empty: month.holidays.length === 0 }}>
                                    {month.holidays.length === 0 ? (
                                        <tr>
                                            <th scope="row" class="month">{month.name}</th>
                                            <td colspan="2" class="none">Este mes no tiene festivos</td>
                                        </tr>
                                    ) : (
                                        month.holidays.map((holiday, index) => (
                                            <tr class="holiday" data-date={holiday.date}>
                                                {index === 0 && (
                                                    <th scope="rowgroup" class="month" rowspan={month.holidays.length}>
                                                        {month.name}
                                                    </th>
                                                )}
                                                <td class="date">
                                                    <time datetime={holiday.date}>
                                                        <span class="d">{dayOf(holiday.date)}</span>{" "}
                                                        <span class="wd">{WEEKDAYS[weekdayOf(holiday.date)]}</span>
                                                        <span class="sr-only"> de {month.name}</span>
                                                    </time>
                                                </td>
                                                <td>
                                                    <strong>
                                                        {holiday.name}
                                                        {holiday === newest && <span class="badge">Nuevo</span>}
                                                    </strong>
                                                    <span class="note">{describe(holiday)}</span>
                                                </td>
                                            </tr>
                                        ))
                                    )}
                                </tbody>
                            ))}
                        </table>
                    ))
                }
            </div>
        </section>

        <div class="calendar-layout">
            <section id="calendario" aria-labelledby="calendario-titulo">
                <header class="head stacked">
                    <h2 id="calendario-titulo">Calendario {YEAR}</h2>
                    <p>
                        Domingos y festivos en rojo, como en el almanaque de la tienda. En rosado, los
                        días que se suman a un puente.
                    </p>
                </header>

                <div class="wall">
                    <p class="print print-title">Festivos en Colombia {YEAR}</p>
                    <ol class="year" aria-hidden="true">
                        {
                            months.map((month) => (
                                <li class="cal-month" data-month={month.number}>
                                    <p class="cal-name">
                                        {month.name}
                                        {month.holidays.length === 0 && <span>sin festivos</span>}
                                    </p>
                                    <div class="cal-weekdays">
                                        {["D", "L", "M", "M", "J", "V", "S"].map((letter) => (
                                            <i data-w={letter} />
                                        ))}
                                    </div>
                                    <ol class="cal-days" style={`--offset: ${month.offset}`}>
                                        {month.days.map(({ holiday, bridge, sunday }) => (
                                            <li class:list={{ hol: holiday, bridge, sun: sunday }} data-name={holiday?.name} />
                                        ))}
                                    </ol>
                                    <ul class="print cal-list">
                                        {month.holidays.map(({ date, name }) => (
                                            <li>
                                                <b>{dayOf(date)}</b> {name}
                                            </li>
                                        ))}
                                    </ul>
                                </li>
                            ))
                        }
                    </ol>
                    <ul class="legend" aria-hidden="true">
                        <li><i class="key-hol"></i>Festivo</li>
                        <li><i class="key-bridge"></i>Se suma al puente</li>
                        <li><i class="key-sun">7</i>Domingo</li>
                    </ul>
                    <p class="print print-foot">antojsh.dev/festivos-colombia-2027</p>
                </div>
            </section>

            <section id="puentes" class="no-print" aria-labelledby="puentes-titulo">
                <header class="head stacked">
                    <h2 id="puentes-titulo">Puentes festivos {YEAR}</h2>
                    <p>
                        {longWeekends.length} fines de semana largos:
                        {longWeekends.filter(({ days }) => days === 3).length} de tres días y la Semana Santa,
                        de cuatro.
                    </p>
                </header>

                <ol class="bridges">
                    {
                        longWeekends.map((weekend) => (
                            <li>
                                <ol class="strip" aria-hidden="true">
                                    {daysOf(weekend).map((date) => {
                                        const cell = stripDay(date, byDate.has(date) ? "hol" : "off");
                                        return <li class={cell.type} data-w={cell.weekday} data-d={cell.day} />;
                                    })}
                                </ol>
                                <div>
                                    <p class="bridge-name">{restName(weekend.holidays)}</p>
                                    <p class="bridge-dates">{capitalize(formatRange(weekend.start, weekend.end))}</p>
                                </div>
                            </li>
                        ))
                    }
                </ol>
            </section>
        </div>

        <section id="vacaciones" class="no-print" aria-labelledby="vacaciones-titulo">
            <header class="head">
                <h2 id="vacaciones-titulo">Vacaciones {YEAR}: los días que más rinden</h2>
                <p>
                    Si puedes pedir días, pídelos aquí: cada plan une festivos y fines de semana. Cuentas
                    hechas para quien trabaja de lunes a viernes.
                </p>
            </header>

            <ol class="plans">
                {
                    plans.map((plan) => (
                        <li class="plan">
                            <p class="ratio">
                                <span class="ask">
                                    <b>{plan.leave.length}</b>
                                    {plan.leave.length === 1 ? "día que pides" : "días que pides"}
                                </span>
                                <span class="rest">
                                    <b>{plan.days}</b>
                                    días de descanso
                                </span>
                            </p>
                            <div class="plan-text">
                                <h3>{capitalize(formatRange(plan.start, plan.end))}</h3>
                                <p>
                                    {`Pide ${formatDays(plan.leave)}. Aprovechas ${joinList(
                                        plan.holidays
                                            .filter(({ date }) => !isWeekend(date))
                                            .map(({ name, date }) => `${name} (${formatWeekdayDay(date)})`),
                                    )}.`}
                                </p>
                            </div>
                            <ol class="strip" aria-hidden="true">
                                {daysOf(plan).map((date) => {
                                    const type = byDate.has(date) ? "hol" : isWeekend(date) ? "off" : "leave";
                                    const cell = stripDay(date, type);
                                    return <li class={cell.type} data-w={cell.weekday} data-d={cell.day} />;
                                })}
                            </ol>
                        </li>
                    ))
                }
            </ol>
            <ul class="legend" aria-hidden="true">
                <li><i class="key-hol"></i>Festivo</li>
                <li><i class="key-bridge"></i>Fin de semana</li>
                <li><i class="key-leave"></i>Día que pides</li>
            </ul>
        </section>

        <section id="ley-emiliani" class="law no-print" aria-labelledby="ley-titulo">
            <div class="law-text">
                <h2 id="ley-titulo">¿Por qué casi todos los festivos caen lunes?</h2>
                <p>
                    Por la <a href={LAW_51_URL} rel="noopener">Ley 51 de 1983</a>, que todos conocen
                    como Ley Emiliani. Para diez festivos dice que,
                </p>
                <blockquote cite={LAW_51_URL}>
                    <p>«cuando no caigan en día lunes se trasladarán al lunes siguiente a dicho día».</p>
                    <footer>Ley 51 de 1983, artículo 1</footer>
                </blockquote>
                <p>
                    En junio de 2026 la <a href={LAW_2578_URL} rel="noopener">Ley 2578</a> sumó un
                    festivo nuevo con la misma regla: el Día de Nuestra Señora del Rosario de
                    Chiquinquirá, el 9 de julio. Por eso ahora son {movable.length}.
                </p>
                <p>
                    Los demás nunca se mueven: {joinList(fixed.map(({ name }) => name))}, además del
                    Jueves y el Viernes Santo. Por eso en {YEAR}
                    {joinList(onSaturday.map(({ date }) => formatLong(date).replace("sábado ", "")))}
                    caen sábado y no dan puente.
                </p>
            </div>

            <table class="moves">
                <caption>Festivos que se corren al lunes en {YEAR}</caption>
                <thead>
                    <tr>
                        <th scope="col">Festivo</th>
                        <th scope="col">Cae</th>
                        <th scope="col">Se descansa</th>
                    </tr>
                </thead>
                <tbody>
                    {
                        movable.map((holiday) => (
                            <tr>
                                <th scope="row">
                                    {holiday.name}
                                    {holiday === newest && <span class="badge">Nuevo</span>}
                                </th>
                                <td class="from">
                                    <time datetime={holiday.movedFrom ?? holiday.date}>
                                        {formatShort(holiday.movedFrom ?? holiday.date)}
                                    </time>
                                </td>
                                <td class="to">
                                    {holiday.movedFrom ? (
                                        <time datetime={holiday.date}>{formatShort(holiday.date)}</time>
                                    ) : (
                                        "Igual, ya es lunes"
                                    )}
                                </td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </section>

