---
import Layout from "@/layouts/Layout.astro";

import About from "@/components/sections/About.astro";
import Contact from "@/components/sections/Contact.astro";
import Experience from "@/components/sections/Experience.astro";
import Hero from "@/components/sections/Hero.astro";
import PersonalProjects from "@/components/sections/PersonalProjects.astro";
import Projects from "@/components/sections/Projects.astro";
import Skills from "@/components/sections/Skills.astro";
import KeyboardManager from "@/components/KeyboardManager.astro";

import { basics } from "@cv";
const { name, label, email, image, profiles, location } = basics;
const site = Astro.site?.href ?? "/";

const jsonLd = [
    {
        "@context": "https://schema.org",
        "@type": "Person",
        name,
        jobTitle: "Desarrollador Full Stack",
        description: label,
        url: site,
        email: `mailto:${email}`,
        image: new URL(image, site).href,
        address: {
            "@type": "PostalAddress",
            addressLocality: location.city,
            addressCountry: location.countryCode,
        },
        sameAs: profiles.map(({ url }) => url),
        knowsAbout: ["Angular", "TypeScript", "Node.js", "Sistemas de diseño", "Desarrollo web"],
    },
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: `Portafolio de ${name}`,
        url: site,
        inLanguage: "es-CO",
    },
];
---

<Layout title={`Portafolio de ${name} - ${label}`} type="profile" jsonLd={jsonLd}>
    <main>
        <Hero />
        <About />
        <PersonalProjects />
        <Experience />
        <!-- <Education /> -->
        <Projects />
        <Skills />
        <Contact />
    </main>

    <KeyboardManager />
</Layout>

<style>
    main {
        width: min(1180px, 100%);
        padding: clamp(1.25rem, 3vw, 2rem) clamp(1.25rem, 4vw, 3rem) 6rem;
        margin: auto;
    }

    @media print {
        main {
            width: 100%;
            padding: 0;
        }
    }
</style>
