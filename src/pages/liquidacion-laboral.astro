---
import Layout from "@/layouts/Layout.astro";
import { basics } from "@cv";
import { MONTHS_SHORT, formatLong } from "@/lib/festivos";
import {
    CONTRACT_TYPES,
    ENDINGS,
    LIQUIDACION_REVIEW,
    calculateLiquidacion,
    formatCOP,
    formatNumber,
    isCompensated,
    type Ending,
} from "@/lib/liquidacion";
import { getMinimumWage, transportLimit } from "@/lib/prima";

const CST_URL = "https://www.funcionpublica.gov.co/eva/gestornormativo/norma.php?i=199983";
const LAW_50_URL = "https://www.funcionpublica.gov.co/eva/gestornormativo/norma.php?i=281";
const LAW_2466_URL = "https://www.funcionpublica.gov.co/eva/gestornormativo/norma.php?i=260676";

const TODAY = LIQUIDACION_REVIEW;
const YEAR = Number(TODAY.slice(0, 4));
const wage = getMinimumWage(YEAR);
const limit = transportLimit(wage);

// Ejemplo inicial: tres años y medio con el mínimo, despido sin justa causa
const example = {
    contract: "indefinido",
    ending: "despido-sin-justa-causa",
    start: `${YEAR - 3}-05-02`,
    end: TODAY,
    salary: wage.salary,
    transport: true,
    unpaidSalaryDays: Number(TODAY.slice(8, 10)),
} as const;
const result = calculateLiquidacion(example);

// Indemnización con el mínimo, por años de servicio
const compensationRows = [1, 2, 3, 5, 10, 15, 20].map((years) => {
    const low = years <= 1 ? 30 : 30 + 20 * (years - 1);
    const high = years <= 1 ? 20 : 20 + 15 * (years - 1);
    return { years, low, high, value: Math.round((wage.salary / 30) * low) };
});

type Mark = "si" | "no" | "a-veces";
const concepts = ["Salario pendiente", "Cesantías e intereses", "Prima", "Vacaciones", "Indemnización"];
const matrix: { ending: Ending; label: string; marks: Mark[] }[] = ENDINGS.map(({ value, label }) => ({
    ending: value,
    label,
    marks: ["si", "si", "si", "si", isCompensated(value) ? "si" : value === "mutuo-acuerdo" ? "a-veces" : "no"],
}));

const longDate = (date: string) => `${formatLong(date).replace(/^\S+ /, "")} de ${date.slice(0, 4)}`;

const faqs = [
    {
        question: "¿Qué me deben pagar en la liquidación?",
        answer: "Siempre: el salario que te deban, las cesantías y sus intereses del año en curso, la prima del semestre en curso y las vacaciones que no alcanzaste a disfrutar. Si te despidieron sin justa causa, además la indemnización del artículo 64 del Código Sustantivo del Trabajo.",
    },
    {
        question: "¿Si renuncio me pagan liquidación?",
        answer: "Sí. Renunciar no te quita las prestaciones sociales: te pagan salario pendiente, cesantías, intereses, prima y vacaciones proporcionales al tiempo trabajado. Lo único que no recibes es la indemnización, que es solo para despidos sin justa causa.",
    },
    {
        question: "¿Cuánto es la indemnización por despido sin justa causa?",
        answer: `En un contrato indefinido, si ganas menos de 10 salarios mínimos: 30 días de salario por el primer año y 20 días por cada año siguiente, en proporción. Si ganas 10 mínimos o más: 20 días por el primer año y 15 por cada año siguiente. Con el mínimo de ${YEAR} y tres años de trabajo son 70 días, ${formatCOP((wage.salary / 30) * 70)}. La reforma laboral de 2025 no cambió estos valores.`,
    },
    {
        question: "¿Cómo se indemniza un contrato a término fijo?",
        answer: "Con los salarios del tiempo que faltaba para que se venciera el contrato. Si te despiden sin justa causa cuando faltan cuatro meses, te deben cuatro meses de salario. En el contrato por obra o labor es el tiempo que faltaba para terminar la obra, y nunca menos de 15 días.",
    },
    {
        question: "¿Cuándo me tienen que pagar la liquidación?",
        answer: "El día en que termina el contrato. La ley no da un plazo adicional. Si el empleador no paga y no tiene una razón de buena fe, el artículo 65 lo obliga a pagar un día de salario por cada día de retraso, hasta por 24 meses; después corren intereses moratorios. Si ganas el mínimo, esa sanción no tiene el tope de 24 meses.",
    },
    {
        question: "¿Cómo se calculan las cesantías en la liquidación?",
        answer: "Salario más auxilio de transporte, por los días trabajados en el año de la terminación, dividido entre 360. Las cesantías de años anteriores no van en la liquidación porque el empleador debió consignarlas en tu fondo antes del 15 de febrero; si no lo hizo, te las debe pagar directamente.",
    },
    {
        question: "¿Cuánto son los intereses de las cesantías?",
        answer: "El 12 % anual sobre las cesantías, en proporción a los días trabajados: cesantías × días × 0,12 ÷ 360. Te los paga directamente el empleador, no el fondo.",
    },
    {
        question: "¿Cómo se pagan las vacaciones que no tomé?",
        answer: "Al terminar el contrato se compensan en dinero por año y por fracción de año (art. 189). Por cada año trabajado ganas 15 días hábiles; el valor de cada día es el salario mensual dividido entre 30. No incluye el auxilio de transporte ni las horas extra.",
    },
    {
        question: "¿Me descuentan salud y pensión en la liquidación?",
        answer: "Solo sobre el salario pendiente: 4 % para salud y 4 % para pensión, más el Fondo de Solidaridad Pensional si ganas 4 mínimos o más. Las cesantías, los intereses, la prima y la indemnización no pagan aportes. La indemnización y otros pagos sí pueden tener retención en la fuente si tus ingresos son altos.",
    },
    {
        question: "¿Qué pasa si me despiden en el periodo de prueba?",
        answer: "Cualquiera de los dos puede terminar el contrato sin preaviso y sin indemnización. Igual te deben pagar el salario y las prestaciones por los días trabajados.",
    },
    {
        question: "¿Qué es el despido indirecto?",
        answer: "Cuando renuncias porque el empleador incumplió sus obligaciones: no te paga, te acosa o te cambia las condiciones de forma grave. Debes decir el motivo por escrito en la carta de renuncia. Si un juez te da la razón, se indemniza igual que un despido sin justa causa.",
    },
    {
        question: "¿Me pueden despedir si estoy embarazada o incapacitado?",
        answer: "No sin permiso del Ministerio del Trabajo. Las trabajadoras en embarazo o lactancia y quienes tienen una condición de salud que les dificulta trabajar tienen estabilidad laboral reforzada. Un despido sin ese permiso puede ser anulado por un juez, con reintegro y una indemnización adicional. Busca asesoría antes de firmar.",
    },
    {
        question: "¿Tengo que firmar el paz y salvo?",
        answer: "No estás obligado a firmar si no estás de acuerdo con los valores. Firmar la liquidación tampoco te hace perder derechos que la ley considera irrenunciables, pero es mejor revisar cada cifra antes. Puedes dejar constancia escrita de tu desacuerdo.",
    },
];

const site = Astro.site?.href ?? "/";
const pageUrl = new URL("/liquidacion-laboral", site).href;
const title = `Calculadora de liquidación laboral ${YEAR}: cesantías, prima, vacaciones e indemnización`;
const description = `Calcula tu liquidación si renunciaste o te despidieron: salario pendiente, cesantías, intereses, prima, vacaciones e indemnización, con el detalle de cada cuenta.`;
const image = new URL("/og/liquidacion-laboral.png", site).href;
const personId = new URL("/#person", site).href;

const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebPage",
            "@id": `${pageUrl}#webpage`,
            url: pageUrl,
            name: title,
            description,
            inLanguage: "es-CO",
            isPartOf: { "@id": new URL("/#website", site).href },
            author: { "@id": personId },
            dateModified: LIQUIDACION_REVIEW,
            primaryImageOfPage: { "@type": "ImageObject", url: image, width: 1200, height: 630 },
            about: { "@type": "Thing", name: "Liquidación de contrato de trabajo en Colombia" },
            mainEntity: { "@id": `${pageUrl}#calculadora` },
            breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
        },
        {
            "@type": "WebApplication",
            "@id": `${pageUrl}#calculadora`,
            name: "Calculadora de liquidación laboral",
            url: pageUrl,
            applicationCategory: "FinanceApplication",
            operatingSystem: "Web",
            inLanguage: "es-CO",
            isAccessibleForFree: true,
            offers: { "@type": "Offer", price: 0, priceCurrency: "COP" },
            author: { "@id": personId },
        },
        {
            "@type": "FAQPage",
            "@id": `${pageUrl}#preguntas`,
            mainEntity: faqs.map(({ question, answer }) => ({
                "@type": "Question",
                name: question,
                acceptedAnswer: { "@type": "Answer", text: answer },
            })),
        },
        {
            "@type": "BreadcrumbList",
            "@id": `${pageUrl}#breadcrumb`,
            itemListElement: [
                { "@type": "ListItem", position: 1, name: "Inicio", item: site },
                { "@type": "ListItem", position: 2, name: "Liquidación laboral", item: pageUrl },
            ],
        },
        {
            "@type": "Person",
            "@id": personId,
            name: basics.name,
            url: site,
            sameAs: basics.profiles.map(({ url }) => url),
        },
    ],
};

const markLabel: Record<Mark, string> = { si: "Sí", no: "No", "a-veces": "Si lo pactan" };
---

<Layout
    title={title}
    description={description}
    image="/og/liquidacion-laboral.png"
    imageAlt="Acta de liquidación con salario, cesantías, intereses, prima, vacaciones e indemnización"
    imageWidth={1200}
    imageHeight={630}
    canvas={false}
    jsonLd={jsonLd}
>
    <div class="flag" aria-hidden="true"></div>

    <main>
        <header class="topbar">
            <nav aria-label="Ruta de navegación">
                <ol class="crumbs">
                    <li>
                        <a href="/"><span class="monogram" aria-hidden="true">AS</span>antojsh.dev</a>
                    </li>
                    <li aria-current="page">Liquidación laboral</li>
                </ol>
            </nav>
            <nav class="toc" aria-label="En esta página">
                <a href="#calculadora">Calculadora</a>
                <a href="#que-te-pagan">Qué te pagan</a>
                <a href="#indemnizacion">Indemnización</a>
                <a href="#plazos">Plazos</a>
                <a href="#preguntas">Preguntas</a>
            </nav>
        </header>

        <section class="hero">
            <h1>Calculadora de <span>liquidación</span> laboral</h1>
            <p class="lead">
                Renunciaste o te despidieron: te deben <strong>salario pendiente, cesantías, intereses, prima y
                vacaciones</strong>, y si el despido fue sin justa causa, también una <strong>indemnización</strong>.
                Llena tus datos y revisa cada cuenta antes de firmar.
            </p>
            <p class="updated">
                Actualizado el <time datetime={LIQUIDACION_REVIEW}>{longDate(LIQUIDACION_REVIEW)}</time>
                · Según el <a href={CST_URL} rel="noopener">Código Sustantivo del Trabajo</a>, la
                <a href={LAW_50_URL} rel="noopener">Ley 50 de 1990</a> y la
                <a href={LAW_2466_URL} rel="noopener">Ley 2466 de 2025</a>
            </p>
        </section>

        <section id="calculadora" class="calculator" aria-labelledby="calculadora-titulo">
            <h2 id="calculadora-titulo" class="sr-only">Calcula tu liquidación</h2>

            <form class="form" data-form>
                <fieldset class="group">
                    <legend>Tu contrato</legend>
                    <div class="options three">
                        {
                            CONTRACT_TYPES.map(({ value, label, hint }) => (
                                <label class="option">
                                    <input type="radio" name="contrato" value={value} checked={value === example.contract} />
                                    <span>
                                        <strong>{label}</strong>
                                        <small>{hint}</small>
                                    </span>
                                </label>
                            ))
                        }
                    </div>
                    <div class="pair">
                        <label class="small-field">
                            Primer día de trabajo
                            <input type="date" name="inicio" value={example.start} required />
                        </label>
                        <label class="small-field">
                            Último día de trabajo
                            <input type="date" name="fin" value={example.end} required />
                        </label>
                    </div>
                    <label class="small-field" data-agreed hidden>
                        <span data-agreed-label>Fecha en que vencía el contrato</span>
                        <input type="date" name="pactado" />
                        <small class="hint" data-agreed-hint>Con ella se calcula la indemnización si te despidieron antes.</small>
                    </label>
                </fieldset>

                <fieldset class="group">
                    <legend>¿Cómo terminó?</legend>
                    <div class="endings">
                        {
                            ENDINGS.map(({ value, label, hint }) => (
                                <label class="ending" data-ending={value}>
                                    <input type="radio" name="terminacion" value={value} checked={value === example.ending} />
                                    <span>
                                        <strong>{label}</strong>
                                        <small>{hint}</small>
                                    </span>
                                </label>
                            ))
                        }
                    </div>
                </fieldset>

                <fieldset class="group">
                    <legend>Tu salario</legend>
                    <div class="money">
                        <span aria-hidden="true">$</span>
                        <input
                            id="salario"
                            name="salario"
                            type="text"
                            inputmode="numeric"
                            autocomplete="off"
                            value={formatNumber(wage.salary)}
                            aria-label="Salario mensual"
                            aria-describedby="salario-ayuda"
                        />
                    </div>
                    <p class="hint" id="salario-ayuda">
                        Salario básico mensual, antes de descuentos.
                        <button type="button" class="link" data-minimum>Usar el mínimo ({formatCOP(wage.salary)})</button>
                    </p>
                    <label class="switch">
                        <input type="checkbox" name="auxilio" checked />
                        <span class="track" aria-hidden="true"></span>
                        <span>Recibía auxilio de transporte</span>
                    </label>
                    <p class="hint" data-transport-hint>Le corresponde a quien gana hasta {formatCOP(limit)}.</p>
                    <label class="switch">
                        <input type="checkbox" name="integral" />
                        <span class="track" aria-hidden="true"></span>
                        <span>Tenía salario integral</span>
                    </label>
                    <p class="hint">
                        Mínimo 13 salarios mínimos ({formatCOP(wage.salary * 13)}). Ya incluye cesantías, intereses y
                        prima.
                    </p>
                </fieldset>

                <details class="more">
                    <summary>Horas extra, comisiones y otros pagos</summary>
                    <div class="more-body">
                        <label class="small-field">
                            Horas extra y trabajo en dominicales o festivos
                            <span class="money compact">
                                <span aria-hidden="true">$</span>
                                <input name="extras" type="text" inputmode="numeric" autocomplete="off" placeholder="0" />
                            </span>
                            <small class="hint">Promedio mensual del último año. No cuenta para vacaciones.</small>
                        </label>
                        <label class="small-field">
                            Comisiones, recargo nocturno y otros pagos que son salario
                            <span class="money compact">
                                <span aria-hidden="true">$</span>
                                <input name="variables" type="text" inputmode="numeric" autocomplete="off" placeholder="0" />
                            </span>
                            <small class="hint">Promedio mensual del último año. Bonos ocasionales y viáticos no cuentan.</small>
                        </label>
                    </div>
                </details>

                <details class="more">
                    <summary>Salario y vacaciones pendientes</summary>
                    <div class="more-body">
                        <label class="small-field">
                            Días de salario que te deben
                            <input name="pendientes" type="number" min="0" max="31" inputmode="numeric" />
                            <small class="hint">Calculado desde el inicio del mes. Cámbialo si te pagan por quincena.</small>
                        </label>
                        <label class="small-field">
                            Días de vacaciones pendientes
                            <input name="vacaciones" type="number" min="0" step="0.01" inputmode="decimal" />
                            <small class="hint" data-vacation-hint>
                                Calculado con el año de servicio en curso, suponiendo que disfrutaste las de cada año
                                cumplido. Si te deben periodos anteriores, súmalos (15 días hábiles por año).
                            </small>
                        </label>
                        <label class="small-field">
                            Días de licencia no remunerada este año
                            <input name="licencias" type="number" min="0" max="360" inputmode="numeric" placeholder="0" />
                            <small class="hint">Esos días no suman. Las incapacidades y las vacaciones sí.</small>
                        </label>
                        <label class="check">
                            <input type="checkbox" name="anteriores" />
                            <span>No me consignaron las cesantías del año pasado</span>
                        </label>
                    </div>
                </details>
            </form>

            <div class="act" id="resultado" data-act>
                <header class="act-head">
                    <span class="act-kicker">Acta de liquidación</span>
                    <span class="act-period" data-period>
                        Del {longDate(example.start)} al {longDate(example.end)}
                    </span>
                </header>
                <ul class="items" data-items>
                    {
                        result.items.map(({ key, label, value, formula, note }) => (
                            <li class:list={["item", { minus: value < 0 }]} data-key={key}>
                                <span class="item-row">
                                    <span>{label}</span>
                                    <b>{value < 0 ? `−${formatCOP(-value)}` : formatCOP(value)}</b>
                                </span>
                                <span class="item-calc">{formula}</span>
                                <span class="item-note">{note}</span>
                            </li>
                        ))
                    }
                </ul>
                <p class="act-total">
                    <span>Total a recibir</span>
                    <b data-total>{formatCOP(result.total)}</b>
                    <span class="stamp" data-stamp aria-hidden="true">Con indemnización</span>
                </p>
                <p class="late" data-late>
                    Te la deben pagar el último día de trabajo. Por cada día de retraso sin justificación, el
                    empleador te debe <b data-daily>{formatCOP(result.dailySalary)}</b> más (art. 65).
                </p>
                <p class="sr-only" aria-live="polite" data-announce></p>
            </div>
        </section>

        <a class="peek" href="#resultado" data-peek aria-hidden="true" tabindex="-1">
            <span>Tu liquidación</span>
            <b data-peek-total>{formatCOP(result.total)}</b>
            <span class="peek-more">Ver detalle</span>
        </a>

        <section class="periods" aria-labelledby="periodos-titulo">
            <header class="head">
                <h2 id="periodos-titulo">Qué tiempo cubre cada pago</h2>
                <p>
                    Cada concepto se cuenta desde una fecha distinta. Por eso la liquidación no es simplemente
                    "un salario por año".
                </p>
            </header>
            <div class="timeline" data-timeline>
                <div class="months" aria-hidden="true">
                    {MONTHS_SHORT.map((month) => <span>{month}</span>)}
                </div>
                <div class="track-row">
                    <span class="track-label">Cesantías e intereses <small data-span="cesantias">{result.severanceDays} días</small></span>
                    <span class="lane"><span class="bar" data-bar="cesantias"></span></span>
                </div>
                <div class="track-row">
                    <span class="track-label">Prima <small data-span="prima">{result.primaDays} días</small></span>
                    <span class="lane"><span class="bar" data-bar="prima"></span></span>
                </div>
                <div class="track-row whole">
                    <span class="track-label">Vacaciones e indemnización <small data-span="todo">{result.serviceDays} días</small></span>
                    <span class="lane"><span class="bar full"></span></span>
                    <span class="whole-note" data-whole-note>Todo el contrato</span>
                </div>
            </div>
        </section>

        <section id="que-te-pagan" aria-labelledby="pagan-titulo">
            <header class="head">
                <h2 id="pagan-titulo">Qué te pagan según cómo terminó</h2>
                <p>
                    Las prestaciones se pagan siempre, sin importar quién terminó el contrato. La indemnización
                    depende de cómo terminó.
                </p>
            </header>
            <div class="matrix-wrap">
                <table class="matrix">
                    <caption class="sr-only">Pagos de la liquidación según la forma de terminación</caption>
                    <thead>
                        <tr>
                            <th scope="col">Cómo terminó</th>
                            {concepts.map((concept) => <th scope="col">{concept}</th>)}
                        </tr>
                    </thead>
                    <tbody>
                        {
                            matrix.map(({ label, marks }) => (
                                <tr>
                                    <th scope="row">{label}</th>
                                    {marks.map((mark) => (
                                        <td class={mark}>{markLabel[mark]}</td>
                                    ))}
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section id="indemnizacion" aria-labelledby="indemnizacion-titulo">
            <header class="head">
                <h2 id="indemnizacion-titulo">Indemnización por despido sin justa causa</h2>
                <p>
                    Contrato indefinido, artículo 64. La reforma laboral de 2025 no cambió estos días. Valores con
                    el salario mínimo de {YEAR}.
                </p>
            </header>
            <div class="comp">
                <table class="amounts">
                    <caption class="sr-only">Días de indemnización por años trabajados</caption>
                    <thead>
                        <tr>
                            <th scope="col">Años trabajados</th>
                            <th scope="col">Menos de 10 mínimos</th>
                            <th scope="col">Con el mínimo</th>
                            <th scope="col">10 mínimos o más</th>
                        </tr>
                    </thead>
                    <tbody>
                        {
                            compensationRows.map(({ years, low, high, value }) => (
                                <tr>
                                    <th scope="row">{years} {years === 1 ? "año o menos" : "años"}</th>
                                    <td>{low} días</td>
                                    <td class="strong">{formatCOP(value)}</td>
                                    <td>{high} días</td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
                <div class="comp-notes">
                    <article>
                        <h3>Término fijo</h3>
                        <p>Los salarios que faltaban hasta la fecha de vencimiento del contrato.</p>
                    </article>
                    <article>
                        <h3>Obra o labor</h3>
                        <p>El tiempo que faltaba para terminar la obra, nunca menos de 15 días de salario.</p>
                    </article>
                    <article>
                        <h3>Fracciones de año</h3>
                        <p>
                            Se pagan en proporción: con el mínimo, dos años y medio son 30 + 20 × 1,5 = 60 días.
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <section id="plazos" aria-labelledby="plazos-titulo">
            <header class="head">
                <h2 id="plazos-titulo">Plazos y sanciones</h2>
                <p>Si el empleador se demora, la deuda crece. Estas son las fechas que debes tener presentes.</p>
            </header>
            <ol class="deadlines">
                <li>
                    <strong>El último día de trabajo</strong>
                    <span>Se paga la liquidación completa. Si no, corre un día de salario por cada día de retraso (art. 65).</span>
                </li>
                <li>
                    <strong>31 de enero</strong>
                    <span>Plazo para pagar los intereses de cesantías del año anterior. Si no los pagan, se deben dobles.</span>
                </li>
                <li>
                    <strong>14 de febrero</strong>
                    <span>Plazo para consignar las cesantías del año anterior en el fondo. Si no, un día de salario por cada día de retraso (Ley 50 de 1990, art. 99).</span>
                </li>
                <li>
                    <strong>Tres años</strong>
                    <span>Tiempo que tienes para reclamar ante un juez. Después, los derechos laborales prescriben.</span>
                </li>
            </ol>
        </section>

        <section id="preguntas" class="faq" aria-labelledby="preguntas-titulo">
            <header class="head stacked">
                <h2 id="preguntas-titulo">Preguntas frecuentes</h2>
                <p>
                    Esta calculadora es una guía y no reemplaza la asesoría de un abogado laboral, sobre todo si hay
                    un fuero o una demanda de por medio. ¿Ves un error?
                    <a href={`mailto:${basics.email}?subject=Liquidaci%C3%B3n%20laboral`}>Escríbeme</a>.
                </p>
            </header>
            <div class="faq-list">
                {
                    faqs.map(({ question, answer }, index) => (
                        <details open={index === 0}>
                            <summary>{question}</summary>
                            <p>{answer}</p>
                        </details>
                    ))
                }
            </div>
        </section>

        <footer class="colophon">
            <p>
                Hecho por <a href="/">{basics.name}</a>, desarrollador en {basics.location.city}. Fuentes:
                <a href={CST_URL} rel="noopener">Código Sustantivo del Trabajo</a> (arts. 64, 65, 189, 249 y 306),
                <a href={LAW_50_URL} rel="noopener">Ley 50 de 1990</a>, Ley 52 de 1975,
                <a href={LAW_2466_URL} rel="noopener">Ley 2466 de 2025</a>, {wage.salaryDecree} y {wage.transportDecree}.
            </p>
            <p>
                También te sirve: <a href="/calculadora-prima">Calculadora de prima</a> ·
                <a href="/salario-minimo-2027">Salario mínimo 2027</a> ·
                <a href="/retencion-en-la-fuente">Retención en la fuente</a> ·
                <a href="/festivos-colombia-2027">Festivos 2027</a>
            </p>
        </footer>
    </main>
</Layout>

<script>
    import { addDays, formatLong, todayInColombia } from "@/lib/festivos";
    import {
        calculateLiquidacion,
        days360,
        formatCOP,
        formatNumber,
        isCompensated,
        parseCOP,
        type ContractType,
        type Ending,
    } from "@/lib/liquidacion";
    import { getMinimumWage, transportLimit } from "@/lib/prima";

    const form = document.querySelector<HTMLFormElement>("[data-form]");
    const act = document.querySelector<HTMLElement>("[data-act]");

    if (form != null && act != null) {
        const input = (name: string) => form.querySelector<HTMLInputElement>(`[name="${name}"]`)!;
        const checked = (name: string) => form.querySelector<HTMLInputElement>(`[name="${name}"]:checked`)!.value;
        const one = <T extends HTMLElement = HTMLElement>(selector: string) => document.querySelector<T>(selector)!;

        const startInput = input("inicio");
        const endInput = input("fin");
        const agreedInput = input("pactado");
        const salaryInput = input("salario");
        const transportInput = input("auxilio");
        const integralInput = input("integral");
        const pendingInput = input("pendientes");
        const vacationInput = input("vacaciones");
        const moneyInputs = [salaryInput, input("extras"), input("variables")];
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        let transportTouched = false;
        let pendingTouched = false;
        let vacationTouched = false;
        let shownTotal = parseCOP(one("[data-total]").textContent ?? "");

        const longDate = (date: string) => `${formatLong(date).replace(/^\S+ /, "")} de ${date.slice(0, 4)}`;
        const money = (value: number) => (value < 0 ? `−${formatCOP(-value)}` : formatCOP(value));
        const escape = (text: string) =>
            text.replace(/[&<>"]/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[char]!);

        const formatMoney = (field: HTMLInputElement) => {
            const value = parseCOP(field.value);
            const caret = field.value.length - (field.selectionStart ?? field.value.length);
            field.value = value ? formatNumber(value) : "";
            const position = Math.max(0, field.value.length - caret);
            field.setSelectionRange(position, position);
        };

        const animateTotal = (target: number) => {
            const element = one("[data-total]");
            if (reduceMotion || shownTotal === target) {
                element.textContent = formatCOP(target);
                shownTotal = target;
                return;
            }
            const from = shownTotal;
            const startTime = performance.now();
            shownTotal = target;
            const step = (now: number) => {
                const progress = Math.min(1, (now - startTime) / 450);
                element.textContent = formatCOP(from + (target - from) * (1 - (1 - progress) ** 3));
                if (progress < 1 && shownTotal === target) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
        };

        // Posición de una fecha dentro de su año, de 0 a 1
        const yearFraction = (date: string, edge: "start" | "end") =>
            Math.min(1, (days360(`${date.slice(0, 4)}-01-01`, date) - (edge === "start" ? 1 : 0)) / 360);

        const update = (): void => {
            const contract = checked("contrato") as ContractType;
            const ending = checked("terminacion") as Ending;
            const start = startInput.value;
            let end = endInput.value;
            if (!start || !end) return;
            if (end < start) end = start;

            const wage = getMinimumWage(Number(end.slice(0, 4)));
            const salary = parseCOP(salaryInput.value);
            const integral = integralInput.checked;

            // El auxilio se marca solo según el salario hasta que la persona lo cambie
            if (!transportTouched) transportInput.checked = !integral && salary > 0 && salary <= transportLimit(wage);
            transportInput.disabled = integral;
            one("[data-transport-hint]").textContent =
                !integral && transportInput.checked && salary > transportLimit(wage)
                    ? `Ojo: con más de ${formatCOP(transportLimit(wage))} no corresponde auxilio de transporte.`
                    : `Le corresponde a quien gana hasta ${formatCOP(transportLimit(wage))}.`;

            // Días de salario pendientes: por defecto, los del mes de la terminación
            if (!pendingTouched) pendingInput.value = String(Math.min(30, Number(end.slice(8, 10))));

            // Fecha pactada solo para término fijo y obra
            const needsAgreed = contract !== "indefinido";
            one("[data-agreed]").hidden = !needsAgreed;
            one("[data-agreed-label]").textContent =
                contract === "fijo" ? "Fecha en que vencía el contrato" : "Fecha en que iba a terminar la obra";
            agreedInput.min = addDays(end, 1);
            one<HTMLLabelElement>('[data-ending="fin-del-plazo"]').hidden = !needsAgreed;
            if (!needsAgreed && ending === "fin-del-plazo") {
                form.querySelector<HTMLInputElement>('[name="terminacion"][value="renuncia"]')!.checked = true;
                return update();
            }

            const result = calculateLiquidacion({
                contract,
                ending,
                start,
                end,
                agreedEnd: agreedInput.value || undefined,
                salary,
                integral,
                transport: transportInput.checked,
                overtime: parseCOP(input("extras").value),
                variable: parseCOP(input("variables").value),
                vacationPending: vacationTouched ? Math.max(0, Number(vacationInput.value) || 0) : undefined,
                unpaidSalaryDays: Math.max(0, Number(pendingInput.value) || 0),
                unpaidLeave: Math.max(0, Number(input("licencias").value) || 0),
                previousSeveranceOwed: input("anteriores").checked,
            });

            // Mientras la persona no lo cambie, el campo muestra el cálculo por defecto
            if (!vacationTouched) vacationInput.value = String(Math.round(result.vacationPending * 100) / 100);

            one("[data-period]").textContent = `Del ${longDate(start)} al ${longDate(end)}`;
            one("[data-items]").innerHTML = result.items
                .map(
                    ({ key, label, value, formula, note }) => `
                    <li class="item${value < 0 ? " minus" : ""}" data-key="${key}">
                        <span class="item-row"><span>${escape(label)}</span><b>${money(value)}</b></span>
                        <span class="item-calc">${escape(formula)}</span>
                        <span class="item-note">${escape(note)}</span>
                    </li>`,
                )
                .join("");
            one("[data-stamp]").hidden = result.compensationDays === 0;
            one("[data-daily]").textContent = formatCOP(result.dailySalary);
            one("[data-peek-total]").textContent = formatCOP(result.total);
            one("[data-announce]").textContent = `Tu liquidación es de ${formatCOP(result.total)}.`;
            animateTotal(result.total);

            // Si el despido merece indemnización pero falta la fecha pactada, se avisa
            one("[data-agreed-hint]").textContent =
                needsAgreed && isCompensated(ending) && !agreedInput.value
                    ? "Escríbela para calcular la indemnización."
                    : "Con ella se calcula la indemnización si te despidieron antes.";

            // Línea de tiempo del año de la terminación
            const bar = (name: string, from: string) => {
                const element = one(`[data-bar="${name}"]`);
                element.style.setProperty("--from", String(yearFraction(from, "start")));
                element.style.setProperty("--to", String(yearFraction(end, "end")));
            };
            bar("cesantias", result.severanceStart);
            bar("prima", result.primaStart);
            one('[data-span="cesantias"]').textContent = `${result.severanceDays} días`;
            one('[data-span="prima"]').textContent = `${result.primaDays} días`;
            one('[data-span="todo"]').textContent = `${result.serviceDays} días`;
            const years = result.serviceDays / 360;
            one("[data-whole-note]").textContent =
                `Todo el contrato: ${years >= 1 ? `${years.toFixed(1).replace(".", ",")} años` : `${Math.round(years * 12)} meses`}, desde el ${longDate(start)}`;
        };

        // Arranca con la fecha de hoy como último día
        const today = todayInColombia();
        endInput.value = today;
        endInput.max = addDays(today, 365);

        form.addEventListener("submit", (event) => event.preventDefault());
        form.addEventListener("input", (event) => {
            const target = event.target as HTMLInputElement;
            if (moneyInputs.includes(target)) formatMoney(target);
            if (target === transportInput) transportTouched = true;
            if (target === pendingInput) pendingTouched = true;
            if (target === vacationInput) vacationTouched = vacationInput.value !== "";
            if (target === integralInput && integralInput.checked) transportTouched = false;
            update();
        });
        form.querySelector("[data-minimum]")!.addEventListener("click", () => {
            salaryInput.value = formatNumber(getMinimumWage(Number(endInput.value.slice(0, 4))).salary);
            integralInput.checked = false;
            transportTouched = false;
            update();
        });

        update();

        // En móvil el acta queda debajo del formulario: una barra muestra el total mientras escribes
        const peek = one("[data-peek]");
        let formVisible = false;
        let actVisible = false;
        const sync = () => peek.classList.toggle("is-visible", formVisible && !actVisible);
        new IntersectionObserver(([entry]) => {
            formVisible = entry.isIntersecting;
            sync();
        }).observe(form);
        new IntersectionObserver(([entry]) => {
            actVisible = entry.isIntersecting;
            sync();
        }).observe(act);
    }
</script>

<style>
