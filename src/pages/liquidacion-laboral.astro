    .form {
        display: grid;
        gap: 34px;
    }

    .group {
        display: grid;
        gap: 12px;
        min-width: 0;
        margin: 0;
        padding: 0;
        border: 0;
    }

    legend {
        margin-bottom: 14px;
        padding: 0;
