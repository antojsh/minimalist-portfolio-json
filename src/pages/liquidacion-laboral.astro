        color: var(--text-soft);
        font-size: 0.88rem;
        font-weight: 600;
    }

    .small-field > input {
        width: 100%;
        padding: 11px 14px;
        border: 1px solid var(--line-strong);
        border-radius: 12px;
        background: var(--sheet);
        color: var(--ink);
        font: inherit;
        font-size: 1rem;
        font-weight: 600;
    }

    .small-field > input[type="number"] {
        width: 140px;
    }

    .small-field > input:focus,
    .money:focus-within {
        border-color: var(--ink);
        outline: 0;
        box-shadow: 0 0 0 3px rgba(21, 25, 30, 0.12);
    }

    .money {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 0 18px;
        border: 1px solid var(--line-strong);
        border-radius: 12px;
        background: var(--sheet);
    }

    .money > span {
        color: var(--muted);
        font-family: var(--font-display);
        font-size: 1.6rem;
        font-weight: 700;
    }

    .money input {
        width: 100%;
        min-width: 0;
        padding: 14px 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--ink);
        font-family: var(--font-display);
        font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem);
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        letter-spacing: -0.03em;
    }

    .money.compact {
        padding: 0 14px;
    }

    .money.compact > span {
        font-size: 1.1rem;
    }

    .money.compact input {
        padding: 10px 0;
        font-size: 1.15rem;
    }

    .hint {
        color: var(--muted);
        font-size: 0.85rem;
        font-weight: 400;
        line-height: 1.5;
    }

    .link {
        padding: 0;
        border: 0;
        background: none;
        color: var(--ink);
        font: inherit;
        font-weight: 600;
        text-decoration: underline;
        text-decoration-color: var(--line-strong);
        text-underline-offset: 3px;
        cursor: pointer;
    }

    .switch {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        margin-top: 8px;
        color: var(--ink);
        font-weight: 600;
        cursor: pointer;
    }

    .switch input {
        position: absolute;
        opacity: 0;
    }

    .track {
        position: relative;
        flex: none;
        width: 46px;
        height: 28px;
        border-radius: 999px;
        background: var(--line-strong);
        transition: background 200ms ease;
    }

    .track::after {
        position: absolute;
        top: 3px;
        left: 3px;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 1px 3px rgba(21, 25, 30, 0.25);
        transition: transform 200ms var(--ease-out);
        content: "";
