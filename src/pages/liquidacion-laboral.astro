        font-size: 0.8rem;
        font-weight: 800;
    }

    .toc {
        display: flex;
        gap: 2px;
        overflow-x: auto;
        scrollbar-width: none;
    }

    .toc a {
        flex: none;
        padding: 8px 13px;
