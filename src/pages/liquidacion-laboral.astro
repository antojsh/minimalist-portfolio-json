    .act-total b {
        color: var(--ink);
        font-family: var(--font-display);
        font-size: clamp(2.4rem, 1.9rem + 1.8vw, 3.2rem);
        font-weight: 800;
        font-variant-numeric: tabular-nums;
        letter-spacing: -0.05em;
