        margin-top: clamp(2.5rem, 5vw, 3.5rem);
    }

    .needs article {
        padding: clamp(18px, 3vw, 26px);
        border-radius: 20px;
        background: var(--sheet);
        box-shadow: inset 0 0 0 1px var(--line);
    }

    .needs ul {
        display: grid;
        gap: 6px;
        margin-top: 12px;
    }

    .needs li {
        position: relative;
        padding-left: 18px;
        color: var(--text-soft);
    }

    .needs li::before {
        position: absolute;
        top: 0.62em;
        left: 0;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--red);
        content: "";
    }

    .needs p {
        margin-top: 10px;
    }

    /* Villancicos */
    .carols {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .carol {
        padding: clamp(22px, 3vw, 32px);
        border-radius: 20px;
        background: var(--paper);
        box-shadow: inset 0 0 0 1px var(--line);
        font-family: var(--serif);
        font-size: 1.12rem;
    }

    .carol h3 {
        font-family: var(--font-display);
    }

    .carol p {
        margin-top: 10px;
        color: #2a2420;
        font-size: inherit;
    }

    .chorus {
        padding: 10px 14px;
        border-radius: 10px;
        background: var(--red-soft);
        color: var(--red-ink) !important;
        font-style: italic;
    }

    .chorus-repeat {
        color: var(--red-ink) !important;
        font-size: 0.85em !important;
        font-style: italic;
    }

    .more-carols {
        margin-top: 22px;
    }

    .more-carols strong {
        color: var(--ink);
    }

    /* Juegos */
    .games {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 28px clamp(24px, 4vw, 48px);
    }

    .games article {
        padding-top: 16px;
        border-top: 2px solid var(--ink);
    }

    .games p {
        margin-top: 8px;
    }

    /* Historia */
    .history {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
        gap: 24px clamp(40px, 7vw, 96px);
        padding: clamp(24px, 4vw, 44px);
        border-radius: 24px;
        background: var(--board);
    }

    .history h2 {
        color: #fff;
    }

    .history-text p {
        color: rgba(255, 255, 255, 0.8);
        font-size: 1.05rem;
    }

    .history-text p + p {
        margin-top: 14px;
    }

    @media (prefers-reduced-motion: reduce) {
        .candle .flame {
            animation: none !important;
        }
    }

    @media (max-width: 1023px) {
        .steps {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .share-out,
        .history,
        .needs,
        .carols {
            grid-template-columns: minmax(0, 1fr);
        }

        .calendar,
        .games {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 640px) {
        .candles {
            padding-inline: 6px;
        }

        .candle-label small {
            display: none;
        }

        .order {
            display: none;
        }

        .book {
            margin-inline: calc(var(--gutter) * -1);
            border-radius: 0;
        }

        .steps,
        .calendar,
        .games {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    /* Impresión: solo el librito, con letra cómoda */
    @media print {
        .book {
            max-width: none;
            margin: 0;
            padding: 0;
            box-shadow: none;
            font-size: 12.5pt;
            line-height: 1.5;
        }

        .prayer,
        .stanza {
            break-inside: avoid;
        }

        :global(body.print-all) .consideration[hidden] {
            display: block !important;
            margin-top: 1.4em;
        }

        :global(body.print-all) .print-day {
            display: block;
            color: var(--red-ink) !important;
            font-weight: 600;
        }

        :global(body.print-all) .book-head {
            display: none;
        }

        .candles-section {
            margin: 0;
        }
    }
</style>
