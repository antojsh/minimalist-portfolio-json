        color: #fff;
        font-family: var(--font-display);
        font-size: 1.2rem;
        font-weight: 800;
    }

    .cal-text {
        display: grid;
    }

    .cal-text strong {
        color: var(--ink);
        font-size: 0.95rem;
    }

    .cal-text small {
        color: var(--muted);
        font-size: 0.84rem;
    }

    /* Paso a paso */
    .steps {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 28px clamp(20px, 3vw, 36px);
